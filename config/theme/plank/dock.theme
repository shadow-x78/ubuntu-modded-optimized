# ─────────────────────────────────────────────
# UMO - Plank Dock Theme
# ─────────────────────────────────────────────
# Translucent black - the plank theme from the
# Orchis GTK source, which the Orchis installer
# never ships. Plank runs with Theme=Gtk+ and
# resolves it from a plank/ folder inside the
# active GTK theme.
#
# Note on TopRoundness: plank hard-codes corner
# radii to 0 when no compositor is running
# (draw_rounded_rect in its Theme.vala), and UMO
# runs the desktop compositor-less for VNC
# performance - so the dock renders square-edged
# here by design. The value is kept at the Orchis
# 18 so a compositor-enabled session gets the
# rounding for free; the colors, paddings and
# indicator style apply either way.

# ── Theme Base ──
[PlankTheme]
TopRoundness=18
BottomRoundness=0
LineWidth=0
OuterStrokeColor=0;;0;;0;;0
FillStartColor=0;;0;;0;;153
FillEndColor=0;;0;;0;;153
InnerStrokeColor=0;;0;;0;;0

# ── Dock Layout ──
[PlankDockTheme]
HorizPadding=1
TopPadding=2
BottomPadding=1
ItemPadding=2
IndicatorSize=5
IconShadowSize=0
UrgentBounceHeight=1.6666666666666667
LaunchBounceHeight=0.625
FadeOpacity=1
ClickTime=0
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=150
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=30
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
BadgeColor=229;;57;;53;;1

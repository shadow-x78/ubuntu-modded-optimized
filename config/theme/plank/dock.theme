# ─────────────────────────────────────────────
# UMO - Plank Dock Theme
# ─────────────────────────────────────────────
# Rounded top corners, translucent black - the
# plank theme from the Orchis GTK source, which
# the Orchis installer never ships. Plank runs
# with Theme=Gtk+ and resolves it from a plank/
# folder inside the active GTK theme.

# ── Theme Base ──
[PlankTheme]
TopRoundness=18
BottomRoundness=0
LineWidth=0
OuterStrokeColor=0;;0;;0;;0
FillStartColor=0;;0;;0;;153
FillEndColor=0;;0;;0;;153
InnerStrokeColor=0;;0;;0;;0

# ── Dock Layout ──
[PlankDockTheme]
HorizPadding=1
TopPadding=2
BottomPadding=1
ItemPadding=2
IndicatorSize=5
IconShadowSize=0
UrgentBounceHeight=1.6666666666666667
LaunchBounceHeight=0.625
FadeOpacity=1
ClickTime=0
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=150
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=30
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
BadgeColor=229;;57;;53;;1

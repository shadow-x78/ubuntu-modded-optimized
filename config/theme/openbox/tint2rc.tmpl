# ─────────────────────────────────────────────
# UMO - Tint2 Panel (rendered per theme mode)
# ─────────────────────────────────────────────

panel_monitor = all
panel_position = bottom center horizontal
panel_items = LTSC
panel_size = 0 30
panel_margin = 0 0
panel_padding = 0 0 2
panel_dock = 0
wm_menu = 1
layer = bottom
autohide = 0
strut_policy = minimum
font_shadow = 0

launcher_item_app = /usr/share/applications/lxterminal.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop

taskbar_mode = single_desktop
taskbar_padding = 0 0 2
taskbar_name = 1
taskbar_name_font = Inter 9
taskbar_name_font_color = {{TASK_FONT}}
taskbar_background_id = 0

task_content = icon_title
task_icon = 1
task_centered = 0
task_maximum_size = 160 30
task_padding = 4 2 2
task_font = Inter 9
task_font_color = {{TASK_FONT}}
task_background_id = 0
task_active_font_color = {{TASK_FONT}}
task_active_background_id = 1
task_tooltip = 0

systray_padding = 2 2 2
systray_sort = ascending

time1_format = %H:%M
time1_font = JetBrains Mono 10
clock_font_color = {{TASK_FONT}}
clock_padding = 4 0
clock_tooltip = %A %B %d

mouse_left = toggle_iconify
mouse_middle = none
mouse_right = close
mouse_scroll_up = toggle
mouse_scroll_down = iconify

rounded = 0
border_width = 0

rounded_1 = 0
border_width_1 = 0
background_color_1 = {{ACTIVE_BG}}
border_color_1 = {{ACCENT}}

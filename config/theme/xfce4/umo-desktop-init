#!/bin/sh
# UMO - In-Container XFCE Desktop First-Boot Init (GPL-3.0-or-later)
# https://github.com/shadow-x78/ubuntu-modded-optimized

command -v xfconf-query >/dev/null 2>&1 || exit 0

WP="/usr/share/wallpapers/umo-wallpaper.jpg"
[ -f "$WP" ] || WP="/usr/local/share/wallpapers/umo-wallpaper.jpg"
[ -f "$WP" ] || exit 0

# The session dbus address is only exported into startxfce4's child chain
# (dbus-launch), so this script discovers the bus from its session file.
# Must happen before ANY xfconf-query call, otherwise they all fail.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    for _bus_file in "$HOME/.dbus/session-bus/"*; do
        [ -f "$_bus_file" ] || continue
        . "$_bus_file" 2>/dev/null || true
        [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && break
    done
    export DBUS_SESSION_BUS_ADDRESS
fi
[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || exit 0

_i=0
until xfconf-query -c xfce4-desktop -l >/dev/null 2>&1; do
    _i=$((_i + 1))
    [ "$_i" -ge 60 ] && break
    sleep 1
done
sleep 2

# Apply the wallpaper to every monitor key we can find (existing xfconf
# entries, xrandr outputs and the common fallback names), retrying a few
# rounds while xfdesktop finishes registering its channels.
_wp_round=0
while [ "$_wp_round" -lt 3 ]; do
    _wp_round=$((_wp_round + 1))

    _mons="$(xfconf-query -c xfce4-desktop -l 2>/dev/null \
        | sed -n 's|.*/backdrop/screen0/\([^/]*\)/.*|\1|p')"
    if command -v xrandr >/dev/null 2>&1; then
        _mons="$_mons
$(xrandr --query 2>/dev/null | awk '/ connected/{print $1}')"
    fi
    _mons="$_mons
monitor0
monitor-0
monitor1
monitorVirtual1
default"
    _mons="$(printf '%s\n' "$_mons" | sed '/^$/d' | sort -u)"

    for _mon in $_mons; do
        _base="/backdrop/screen0/$_mon/workspace0"
        xfconf-query -c xfce4-desktop -p "$_base/image-path" -n -t string -s "$WP" >/dev/null 2>&1 || true
        xfconf-query -c xfce4-desktop -p "$_base/image-path" -s "$WP" >/dev/null 2>&1 || true
        xfconf-query -c xfce4-desktop -p "$_base/last-image" -n -t string -s "$WP" >/dev/null 2>&1 || true
        xfconf-query -c xfce4-desktop -p "$_base/last-image" -s "$WP" >/dev/null 2>&1 || true
        xfconf-query -c xfce4-desktop -p "$_base/last-single-image" -n -t string -s "$WP" >/dev/null 2>&1 || true
        xfconf-query -c xfce4-desktop -p "$_base/last-single-image" -s "$WP" >/dev/null 2>&1 || true
        xfconf-query -c xfce4-desktop -p "$_base/image-show" -n -t bool -s true >/dev/null 2>&1 || true
        xfconf-query -c xfce4-desktop -p "$_base/image-show" -s true >/dev/null 2>&1 || true
        xfconf-query -c xfce4-desktop -p "$_base/image-style" -n -t int -s 5 >/dev/null 2>&1 || true
        xfconf-query -c xfce4-desktop -p "$_base/image-style" -s 5 >/dev/null 2>&1 || true
        xfconf-query -c xfce4-desktop -p "$_base/color-style" -n -t int -s 0 >/dev/null 2>&1 || true
        xfconf-query -c xfce4-desktop -p "$_base/color-style" -s 0 >/dev/null 2>&1 || true
    done

    if xfconf-query -c xfce4-desktop -l -v 2>/dev/null | grep -qF "$WP"; then
        break
    fi
    sleep 5
done

xfconf-query -c xfce4-desktop -p /desktop-icons/style -n -t int -s 0 >/dev/null 2>&1 || true
xfconf-query -c xfce4-desktop -p /desktop-icons/file-icons -n -t int -s 0 >/dev/null 2>&1 || true

# Enforce the UMO theme at session boot (xfconf caches can ignore freshly
# written channel files, so set the live values directly).
_um_mode=$(cat /etc/umo/umo-theme-mode 2>/dev/null || true)
case "$_um_mode" in
    light) _um_gtk="Orchis-Light-Compact"; _um_fbk="Materia-light"; _um_icons="Tela"; _um_fbi="gnome" ;;
    *)     _um_gtk="Orchis-Dark-Compact";  _um_fbk="Materia-dark";  _um_icons="Tela-Black-Dark"; _um_fbi="gnome" ;;
esac
[ -d "/usr/share/themes/$_um_gtk" ] || _um_gtk="$_um_fbk"
[ -d "/usr/share/icons/$_um_icons" ] || _um_icons="$_um_fbi"

_i=0
until xfconf-query -c xsettings -l >/dev/null 2>&1; do
    _i=$((_i + 1))
    [ "$_i" -ge 20 ] && break
    sleep 1
done
if xfconf-query -c xsettings -l >/dev/null 2>&1; then
    xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "$_um_gtk" >/dev/null 2>&1 || true
    xfconf-query -c xsettings -p /Net/ThemeName -s "$_um_gtk" >/dev/null 2>&1 || true
    xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s "$_um_icons" >/dev/null 2>&1 || true
    xfconf-query -c xsettings -p /Net/IconThemeName -s "$_um_icons" >/dev/null 2>&1 || true
fi

exit 0

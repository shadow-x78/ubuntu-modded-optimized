#!/bin/sh

_LOG=/tmp/umo-browser.log
_ts() { date '+%H:%M:%S' 2>/dev/null || echo '?'; }

printf '[%s] launch args: %s\n' "$(_ts)" "$*" >> "$_LOG" 2>/dev/null || true

export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER="${GALLIUM_DRIVER:-llvmpipe}"
[ -n "${DISPLAY:-}" ] || export DISPLAY=:1

if command -v falkon >/dev/null 2>&1; then
    export QTWEBENGINE_DISABLE_SANDBOX=1
    export QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox --disable-gpu --disable-dev-shm-usage ${QTWEBENGINE_CHROMIUM_FLAGS:-}"
    printf '[%s] exec: falkon (DISPLAY=%s)\n' "$(_ts)" "$DISPLAY" >> "$_LOG" 2>/dev/null || true
    exec falkon "$@" >> "$_LOG" 2>&1
fi

printf '[%s] ERROR: no browser binary found - install with: apt-get install -y --no-install-recommends falkon\n' "$(_ts)" >> "$_LOG" 2>/dev/null || true
printf 'UMO Browser: no browser is installed in the container.\n' >&2
printf 'Install one with: apt-get install -y --no-install-recommends falkon\n' >&2
printf 'Full log: %s\n' "$_LOG" >&2
exit 127

#!/bin/sh
VNC_DISPLAY="${VNC_DISPLAY:-:1}"
VNC_GEOMETRY="${VNC_GEOMETRY:-1280x720}"
VNC_DEPTH="${VNC_DEPTH:-24}"
VNC_PORT="${VNC_PORT:-5901}"
_vnc_num="${VNC_DISPLAY#:}"

_GRN='\033[38;5;34m'
_RED='\033[38;5;196m'
_CYN='\033[38;5;39m'
_ORG='\033[38;5;208m'
_YEL='\033[38;5;220m'
_DIM='\033[2m'
_NC='\033[0m'
if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
    _GRN=''; _RED=''; _CYN=''; _ORG=''; _YEL=''; _DIM=''; _NC=''
fi

_UMO_GBLOCK='|'; _UMO_GSTEP='>'; _UMO_GOK='OK'; _UMO_GERR='ERR'; _UMO_GWARN='!'; _UMO_GPLAY='*'
case "${LANG:-}${LC_ALL:-}${LC_CTYPE:-}" in
    *UTF-8*|*utf8*) _UMOG=1 ;;
    *) _UMOG=0; command -v locale >/dev/null 2>&1 && case "$(locale charmap 2>/dev/null)" in UTF-8*|utf-8*) _UMOG=1 ;; esac ;;
esac
if [ "${_UMOG:-0}" = "1" ]; then
    _UMO_GBLOCK='▌'; _UMO_GSTEP='❯'; _UMO_GOK='✔'; _UMO_GERR='✖'; _UMO_GWARN='⚠'; _UMO_GPLAY='▸'
fi

_step() { printf "  %b%s%b  %s\n" "$_ORG" "$_UMO_GBLOCK" "$_NC" "$1"; }
_ok()   { printf "  %b%s%b  %s\n" "$_GRN" "$_UMO_GOK" "$_NC" "$1"; }
_err()  { printf "  %b%s%b  %s\n" "$_RED" "$_UMO_GERR" "$_NC" "$1"; }
_note() { printf "  %b%s%b  %s\n" "$_ORG" "$_UMO_GSTEP" "$_NC" "$1"; }
_hint() { printf "  %b%s%b  %s\n" "$_YEL" "$_UMO_GWARN" "$_NC" "$1"; }
_APT_LOG=/tmp/umo-apt.log
_apt_run() { "$@" >"$_APT_LOG" 2>&1; _apt_rc=$?; grep -E "^(Get:[0-9]|Unpacking |Setting up |Processing |Selecting |E: )" "$_APT_LOG" 2>/dev/null | sed 's/^/    /' || true; return $_apt_rc; }

for _spid in $(pgrep -x "umo-startvnc" 2>/dev/null); do
    [ "$_spid" = "$$" ] && continue
    _skip=0
    _p=$$
    while [ -n "$_p" ] && [ "$_p" != "1" ]; do
        if [ "$_p" = "$_spid" ]; then
            _skip=1
            break
        fi
        _p=$(awk '/^PPid:/{print $2}' "/proc/$_p/status" 2>/dev/null)
    done
    [ "$_skip" = "1" ] && continue
    kill "$_spid" 2>/dev/null || true
done

_step "Starting UMO VNC Server..."

_stop_old_servers() {
    _rounds=0
    while pgrep -x Xtigervnc >/dev/null 2>&1 && [ "$_rounds" -lt 6 ]; do
        pkill -TERM -x Xtigervnc 2>/dev/null || true
        sleep 1
        _rounds=$((_rounds + 1))
        if [ "$_rounds" -ge 3 ]; then
            pkill -KILL -x Xtigervnc 2>/dev/null || true
        fi
    done
    pkill -KILL -x Xvnc 2>/dev/null || true
    sleep 1
}

_cleanup_locks() {
    rm -f "/tmp/.X${_vnc_num}-lock" "/tmp/.X11-unix/X${_vnc_num}" 2>/dev/null || true
    rm -f "$HOME/.vnc/"*":${_vnc_num}.pid" 2>/dev/null || true
}

_stop_old_servers
_cleanup_locks
mkdir -p /tmp/.X11-unix 2>/dev/null || true
chmod 1777 /tmp/.X11-unix 2>/dev/null || true

pulseaudio --start 2>/dev/null || true

if ! command -v Xtigervnc >/dev/null 2>&1; then
    _err "Xtigervnc not found. Install with: apt install tigervnc-standalone-server"
    exit 1
fi
if [ ! -f "$HOME/.vnc/passwd" ]; then
    _err "Missing $HOME/.vnc/passwd - re-run the UMO installer or set it with vncpasswd."
    exit 1
fi
_VNC_XSTARTUP="$HOME/.vnc/xstartup"
if [ ! -x "$_VNC_XSTARTUP" ] && [ -x /root/.vnc/xstartup ]; then
    _VNC_XSTARTUP=/root/.vnc/xstartup
fi
if [ ! -x "$_VNC_XSTARTUP" ]; then
    mkdir -p "$HOME/.vnc" 2>/dev/null || true
    printf '#!/bin/sh\nexec xterm\n' > "$HOME/.vnc/xstartup"
    chmod +x "$HOME/.vnc/xstartup"
    _VNC_XSTARTUP="$HOME/.vnc/xstartup"
fi

export MESA_NO_SHM=1
export GALLIUM_DRIVER=llvmpipe
export LIBGL_ALWAYS_SOFTWARE=1

_xpid=""
_session_pid=""
_start_server() {
    Xtigervnc "$VNC_DISPLAY" \
        -geometry "$VNC_GEOMETRY" \
        -depth "$VNC_DEPTH" \
        -rfbport "$VNC_PORT" \
        -localhost yes \
        -SecurityTypes VncAuth \
        -PasswordFile "$HOME/.vnc/passwd" \
        -alwaysshared \
        -Log "*:stderr:100" </dev/null >> "$HOME/.vnc/xvnc.log" 2>&1 &
    _xpid="$!"
}

_start_session() {
    (
        unset XAUTHORITY
        export DISPLAY="$VNC_DISPLAY"
        exec "$_VNC_XSTARTUP"
    ) >> "$HOME/.vnc/session.log" 2>&1 &
    _session_pid="$!"
}

_de_probe="startxfce4"
if [ -f "$_VNC_XSTARTUP" ]; then
    _de_line=$(sed -n 's/^DE="\(.*\)"/\1/p' "$_VNC_XSTARTUP" 2>/dev/null | head -1)
    case "$_de_line" in
        lxde)    _de_probe="startlxde" ;;
        openbox) _de_probe="openbox-session" ;;
        minimal) _de_probe="xterm" ;;
        xfce4)   _de_probe="startxfce4" ;;
    esac
fi

if ! command -v "$_de_probe" >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1; then
    _note "Desktop Components Missing ($_de_probe) - Installing Automatically (Up To 30 Minutes)"
    export DEBIAN_FRONTEND=noninteractive
    _de_pkgs="xfce4-panel xfce4-session xfce4-settings xfwm4 xfdesktop4 xfce4-terminal thunar dbus-x11 x11-xserver-utils gnome-icon-theme xfce4-whiskermenu-plugin mousepad plank"
    case "$_de_probe" in
        startlxde)      _de_pkgs="lxde-core lxde-common lxsession lxterminal pcmanfm openbox obconf dbus-x11" ;;
        openbox-session) _de_pkgs="openbox obconf lxterminal pcmanfm tint2 feh exo-utils dbus-x11" ;;
        xterm)          _de_pkgs="xterm xfonts-base" ;;
    esac
    _apt_run timeout 300 apt-get update || true
    _apt_run timeout 1800 apt-get install -y --no-install-recommends $_de_pkgs || true
    timeout 300 dpkg --configure -a >/dev/null 2>&1 || true
    if command -v "$_de_probe" >/dev/null 2>&1; then
        _ok "Desktop components installed automatically ($_de_probe)"
    else
        _err "Automatic desktop installation failed - real apt errors:"
        grep -E "^(E:|Err:|W:)" "$_APT_LOG" 2>/dev/null | tail -n 25 | sed 's/^/    /' || true
    fi
fi

_um_theme_mode=$(cat /etc/umo/umo-theme-mode 2>/dev/null || true)
case "$_um_theme_mode" in
    light) _um_theme_dir="/usr/share/themes/Orchis-Light-Compact" ;;
    *)     _um_theme_dir="/usr/share/themes/Orchis-Dark-Compact" ;;
esac
if [ ! -d "$_um_theme_dir" ] && [ -x /usr/local/bin/umo-install-extras ]; then
    bash /usr/local/bin/umo-install-extras "$_um_theme_mode" || true
fi

if ! command -v plank >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1; then
    timeout 300 apt-get install -y --no-install-recommends plank >/dev/null 2>&1 || true
fi

_start_server
sleep 2
if ! kill -0 "$_xpid" 2>/dev/null; then
    if tail -n 5 "$HOME/.vnc/xvnc.log" 2>/dev/null | grep -q "already running"; then
        _note "Another X Server Was Still Holding The Display - Stopping It And Retrying"
        _stop_old_servers
        _cleanup_locks
        _start_server
        sleep 2
    fi
fi
if ! kill -0 "$_xpid" 2>/dev/null; then
    _err "Xtigervnc exited immediately. Last log lines:"
    tail -n 8 "$HOME/.vnc/xvnc.log" 2>/dev/null
    exit 1
fi
_start_session

printf "\n"
printf "  %b────────────────────────────────────────%b\n" "$_ORG" "$_NC"
printf "  %b%s UMO VNC Server Active%b\n" "$_ORG" "$_UMO_GPLAY" "$_NC"
printf "  %b────────────────────────────────────────%b\n" "$_ORG" "$_NC"
printf "\n"
printf "  %bDisplay:%b    %b%s%b\n" "" "$_NC" "$_CYN" "$VNC_DISPLAY" "$_NC"
printf "  %bAddress:%b    %b%s:%s%b\n" "" "$_NC" "$_CYN" "127.0.0.1" "$VNC_PORT" "$_NC"
printf "  %bResolution:%b %b%s%b\n" "" "$_NC" "$_DIM" "$VNC_GEOMETRY" "$_NC"
printf "\n"

_server_fails=0
_session_fails=0
_session_logged=0
while [ "$_server_fails" -lt 5 ]; do
    sleep 5
    if ! kill -0 "$_xpid" 2>/dev/null; then
        _server_fails=$((_server_fails + 1))
        _hint "Xtigervnc died, restarting ($_server_fails/5)"
        kill "$_session_pid" 2>/dev/null || true
        _stop_old_servers
        _cleanup_locks
        _start_server || continue
        sleep 2
        kill -0 "$_xpid" 2>/dev/null || continue
        _start_session
        _session_logged=0
        continue
    fi
    if [ -n "$_session_pid" ] && ! kill -0 "$_session_pid" 2>/dev/null; then
        _session_fails=$((_session_fails + 1))
        if [ "$_session_fails" -le 3 ]; then
            _hint "Desktop session exited ($_session_fails) - last session.log lines:"
            tail -n 10 "$HOME/.vnc/session.log" 2>/dev/null
            _start_session
            _session_logged=0
        elif [ "$_session_logged" = "0" ]; then
            _hint "Desktop session keeps exiting - no more automatic restarts (see $HOME/.vnc/session.log)"
            _session_logged=1
        fi
    fi
done
_err "Xtigervnc kept dying. See $HOME/.vnc/xvnc.log and $HOME/.vnc/session.log"

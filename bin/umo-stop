#!/bin/sh

TERMUX_HOME="${HOME:-/data/data/com.termux/files/home}"
UMO_SCRIPT_HOME="$TERMUX_HOME/.umo"
[ -d "$UMO_SCRIPT_HOME" ] || UMO_SCRIPT_HOME="$TERMUX_HOME"
UMO_LOGIN="$UMO_SCRIPT_HOME/umo-login.sh"
[ -x "$UMO_LOGIN" ] || UMO_LOGIN="$TERMUX_HOME/umo-login.sh"

_UMO_NC='\033[0m'
_UMO_BOLD='\033[1m'
_UMO_PRI='\033[38;5;208m'
_UMO_GRN='\033[38;5;34m'
if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
    _UMO_NC=''; _UMO_BOLD=''; _UMO_PRI=''; _UMO_GRN=''
fi

_UMO_GLYPH=0
case "${LANG:-}${LC_ALL:-}${LC_CTYPE:-}" in
    *UTF-8*|*utf8*) [ -t 1 ] && _UMO_GLYPH=1 ;;
esac
if [ "$_UMO_GLYPH" -eq 0 ] && [ -t 1 ] && command -v locale >/dev/null 2>&1; then
    case "$(locale charmap 2>/dev/null)" in
        UTF-8*|utf-8*) _UMO_GLYPH=1 ;;
    esac
fi
if [ "$_UMO_GLYPH" -eq 1 ]; then
    _G_RUN='❯'
else
    _G_RUN='>'
fi

if [ ! -x "$UMO_LOGIN" ]; then
    printf "\n  %b%s%b  UMO not installed, nothing to stop\n\n" "$_UMO_PRI" "$_G_RUN" "$_UMO_NC"
    exit 0
fi

printf "\n"
if [ "$_UMO_GLYPH" -eq 1 ]; then
    _l1='        ▄▄██▄▄         │                               ';  _l2='    ▄▄██████████▄▄     │                               '
    _l3='   ███▀▄▄      ▀███    │ ██╗   ██╗███╗   ███╗ ██████╗  ';  _l4='  ██▀  ███▄      ▀██   │ ██║   ██║████╗ ████║██╔═══██╗ '
    _l5=' ███     ▀███▄    ███  │ ██║   ██║██╔████╔██║██║   ██║ ';  _l6=' ██        ████    ██  │ ██║   ██║██║╚██╔╝██║██║   ██║ '
    _l7=' ███▄    ▄███▀   ▄███  │ ╚██████╔╝██║ ╚═╝ ██║╚██████╔╝ ';  _l8=' ████▄ ███▀     ▄████  │  ╚═════╝ ╚═╝     ╚═╝ ╚═════╝  '
    _l9=' ▀▀███▄▀▀      ▄███▀▀  │                               ';  _l10='    ▀▀████▄▄████▀▀     │                               '
    _l11='        ▀▀▀▀▀▀         │                               '
else
    _l1='         ####          |                               ';  _l2='     ############      |                               '
    _l3='   ####         ###    |      #   #  #   #   ###       ';  _l4='  ###  ####      ###   |      #   #  ## ##  #   #      '
    _l5=' ###     ####     ###  |      #   #  # # #  #   #      ';  _l6=' ##        ####    ##  |      #   #  #   #  #   #      '
    _l7=' ###     ####     ###  |      #   #  #   #  #   #      ';  _l8=' ##### ####     #####  |       ###   #   #   ###       '
    _l9='  #####         ####   |                               ';  _l10='     ############      |                               '
    _l11='                       |                               '
fi
for _ln in "$_l1" "$_l2" "$_l3" "$_l4" "$_l5" "$_l6" "$_l7" "$_l8" "$_l9" "$_l10" "$_l11"; do
    printf "  %b%s%b\n" "$_UMO_PRI" "$_ln" "$_UMO_NC"
done
printf "\n"

printf "  %b%s%b  Stopping UMO Services...\n" "$_UMO_PRI" "$_G_RUN" "$_UMO_NC"

"$UMO_LOGIN" -c "umo-stopvnc" >/dev/null 2>&1 || true

for _proc in Xvnc Xtigervnc termux-x11 dbus-daemon pulseaudio dconf-service xfce4-session proot; do
    pkill -9 -f "$_proc" 2>/dev/null || true
done

termux-wake-unlock >/dev/null 2>&1 &

printf "\033[1A\033[2K"
printf "  %b────────────────────────────────────────%b\n" "$_UMO_PRI" "$_UMO_NC"
printf "  %b%b▸ UMO Session Stopped%b\n" "$_UMO_BOLD" "$_UMO_GRN" "$_UMO_NC"
printf "  %b────────────────────────────────────────%b\n" "$_UMO_PRI" "$_UMO_NC"
printf "\n"

#!/bin/sh

TERMUX_HOME="${HOME:-/data/data/com.termux/files/home}"
UMO_SCRIPT_HOME="$TERMUX_HOME/.umo"
[ -d "$UMO_SCRIPT_HOME" ] || UMO_SCRIPT_HOME="$TERMUX_HOME"
UMO_LOGIN="$UMO_SCRIPT_HOME/umo-login.sh"
[ -x "$UMO_LOGIN" ] || UMO_LOGIN="$TERMUX_HOME/umo-login.sh"

_UMO_NC='\033[0m'
_UMO_BOLD='\033[1m'
_UMO_DIM='\033[2m'
_UMO_PRI='\033[38;5;208m'
_UMO_GRN='\033[38;5;34m'
_UMO_CYN='\033[38;5;39m'
_UMO_RED='\033[38;5;196m'
_UMO_YEL='\033[38;5;220m'
if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
    _UMO_NC=''; _UMO_BOLD=''; _UMO_DIM=''; _UMO_PRI=''
    _UMO_GRN=''; _UMO_CYN=''; _UMO_RED=''; _UMO_YEL=''
fi

_UMO_GLYPH=0
case "${LANG:-}${LC_ALL:-}${LC_CTYPE:-}" in
    *UTF-8*|*utf8*) [ -t 1 ] && _UMO_GLYPH=1 ;;
esac
if [ "$_UMO_GLYPH" -eq 0 ] && [ -t 1 ] && command -v locale >/dev/null 2>&1; then
    case "$(locale charmap 2>/dev/null)" in
        UTF-8*|utf-8*) _UMO_GLYPH=1 ;;
    esac
fi
if [ "$_UMO_GLYPH" -eq 1 ]; then
    _G_ERR='✖'; _G_WARN='⚠'; _G_RUN='❯'
else
    _G_ERR='ERR'; _G_WARN='!'; _G_RUN='>'
fi

_umo_dp() {
    _dp_base="/data/data/com.termux/files"
    if [ -n "${PREFIX:-}" ]; then
        _dp_files=$(cd "${PREFIX%/}/.." 2>/dev/null && pwd) || _dp_files=""
        case "$_dp_files" in
            */files) _dp_base="$_dp_files" ;;
        esac
    fi
    case "$1" in
        "$_dp_base")   printf '%s' "/" ;;
        "$_dp_base"/*) printf '%s' "${1#"$_dp_base"}" ;;
        *)             printf '%s' "$1" ;;
    esac
}

_umo_refresh_cli() {
    _conf="$UMO_SCRIPT_HOME/umo.conf"
    [ -f "$_conf" ] || _conf="$TERMUX_HOME/.umo/umo.conf"
    _repo=""
    if [ -f "$_conf" ]; then
        _repo=$(sed -n 's/^REPO_DIR="\(.*\)"$/\1/p' "$_conf" 2>/dev/null | head -1)
    fi
    _cli="${TERMUX_PREFIX:-/data/data/com.termux/files/usr}/bin/umo"
    if [ -z "$_repo" ] && [ -f "$_cli" ]; then
        _repo=$(sed -n 's/^_UMO_REPO_DIR="\(.*\)"$/\1/p' "$_cli" 2>/dev/null | head -1)
    fi
    [ -n "$_repo" ] && [ -f "$_repo/bin/umo-cli" ] || return 0
    case "$_repo" in
        *@*@*) return 0 ;;
    esac
    [ -f "$_cli" ] || return 0
    _ver=$(sed -n 's/^export UMO_VERSION="\([^"]*\)"/\1/p' "$_repo/bin/umo-install" 2>/dev/null | head -1)
    [ -n "$_ver" ] || _ver=$(sed -n 's/^_UMO_VERSION="\(.*\)"$/\1/p' "$_cli" 2>/dev/null | head -1)
    case "$_ver" in
        *@*@*) _ver="" ;;
    esac
    _rt=$(sed -n 's/^_UMO_RUNTIME_DIR="\(.*\)"$/\1/p' "$_cli" 2>/dev/null | head -1)
    case "$_rt" in
        ''|*@*@*) _rt="$UMO_SCRIPT_HOME" ;;
    esac
    _ph='@@'
    _esc() { printf '%s' "$1" | sed -e 's/[\\&|"]/\\&/g'; }
    _v_esc=$(_esc "$_ver"); _repo_esc=$(_esc "$_repo"); _rt_esc=$(_esc "$_rt")
    sed -e "s|${_ph}UMO_VERSION${_ph}|$_v_esc|g" \
        -e "s|${_ph}UMO_REPO_DIR${_ph}|$_repo_esc|g" \
        -e "s|${_ph}UMO_RUNTIME_DIR${_ph}|$_rt_esc|g" \
        "$_repo/bin/umo-cli" > "$_cli.new" 2>/dev/null || return 0
    if [ -s "$_cli.new" ] && ! cmp -s "$_cli.new" "$_cli"; then
        if mv -f "$_cli.new" "$_cli" 2>/dev/null; then
            chmod +x "$_cli" 2>/dev/null || true
        fi
    else
        rm -f "$_cli.new" 2>/dev/null || true
    fi
    return 0
}
_umo_refresh_cli

if [ ! -x "$UMO_LOGIN" ]; then
    printf "  %b%s%b  UMO not installed (%s missing)\n" "$_UMO_RED" "$_G_ERR" "$_UMO_NC" "$(_umo_dp "$UMO_LOGIN")"
    printf "      Run the installer first, then: umo start\n"
    exit 1
fi

termux-wake-lock 2>/dev/null || true

pulseaudio --start --exit-idle-time=-1 2>/dev/null || true
sleep 1
if ! pgrep -f pulseaudio >/dev/null 2>&1; then
    printf "  %b%s%b  Audio daemon is not running. Fix: pkg install -y pulseaudio && pulseaudio --start --exit-idle-time=-1\n" "$_UMO_YEL" "$_G_WARN" "$_UMO_NC"
fi

if [ "$1" = "--x11" ] || [ "$1" = "x11" ]; then
    printf "\n"
    if [ "$_UMO_GLYPH" -eq 1 ]; then
        _l1='            ▄████▄            '; _l2='        ▄▄██████████▄▄        '
        _l3='     ▄█████▀▀████▀▀█████▄     '; _l4='    ████▀ ▄▄         ▀████    '
        _l5='   ███▀  ████▄▄        ▀███   '; _l6='  ███▀    ▀▀████▄       ▀███  '
        _l7=' ▄███        ▀█████▄     ███▄ '; _l8=' ████           █████    ████ '
        _l9=' ▀███        ▄█████▀     ███▀ '; _l10='  ████▄   ▄▄████▀      ▄████  '
        _l11='  ██████ ████▀▀       ██████  '; _l12='  ▀█████▄ ▀▀         ▄█████▀  '
        _l13='     ▀█████▄▄▄▄▄▄▄▄█████▀     '; _l14='        ▀▀██████████▀▀        '
        _l15='             ▀▀▀▀             '
    else
        _l1='             ####             '; _l2='         ############         '
        _l3='      ##################      '; _l4='    ####              ####    '
        _l5='   ####  #####         ####   '; _l6='  ###      ######        ###  '
        _l7='  ###         #####      ###  '; _l8=' ####           #####    #### '
        _l9='  ###         #####      ###  '; _l10='  #####    ######      #####  '
        _l11='  ###### #####        ######  '; _l12='  ######              ######  '
        _l13='      ######      ######      '; _l14='         ############         '
        _l15='                              '
    fi
    for _ln in "$_l1" "$_l2" "$_l3" "$_l4" "$_l5" "$_l6" "$_l7" "$_l8" "$_l9" "$_l10" "$_l11" "$_l12" "$_l13" "$_l14" "$_l15"; do
        printf "  %b%s%b\n" "$_UMO_PRI" "$_ln" "$_UMO_NC"
    done
    printf "\n"

    printf "  %b%s%b  Initializing Termux:X11 Services...\n" "$_UMO_PRI" "$_G_RUN" "$_UMO_NC"

    if ! command -v termux-x11 >/dev/null 2>&1; then
        printf "\033[1A\033[2K"
        printf "  %b%s%b  termux-x11-nightly not installed\n" "$_UMO_RED" "$_G_ERR" "$_UMO_NC"
        printf "      %b\$ pkg install x11-repo && pkg install termux-x11-nightly%b\n" "$_UMO_DIM" "$_UMO_NC"
        exit 1
    fi
    export DISPLAY=:0
    export XDG_RUNTIME_DIR="${TMPDIR:-/tmp}"
    nohup termux-x11 :0 >/dev/null 2>&1 &
    sleep 2

    printf "\033[1A\033[2K"
    printf "  %b────────────────────────────────────────%b\n" "$_UMO_PRI" "$_UMO_NC"
    printf "  %b%b▸ UMO X11 Session Active%b\n" "$_UMO_BOLD" "$_UMO_GRN" "$_UMO_NC"
    printf "  %b────────────────────────────────────────%b\n" "$_UMO_PRI" "$_UMO_NC"
    printf "\n"
    printf "  %bDisplay:%b   %b:0%b\n" "$_UMO_BOLD" "$_UMO_NC" "$_UMO_CYN" "$_UMO_NC"
    printf "  %bStop:%b      %bumo stop%b\n" "$_UMO_BOLD" "$_UMO_NC" "$_UMO_CYN" "$_UMO_NC"
    printf "\n"
    printf "  %b────────────────────────────────────────%b\n" "$_UMO_PRI" "$_UMO_NC"
    printf "\n"
    exec "$UMO_LOGIN" -c "export DISPLAY=:0; export XDG_RUNTIME_DIR=${TMPDIR:-/tmp}; bash"
else
    printf "\n"
    if [ "$_UMO_GLYPH" -eq 1 ]; then
        _l1='            ▄████▄            '; _l2='        ▄▄██████████▄▄        '
        _l3='     ▄█████▀▀████▀▀█████▄     '; _l4='    ████▀ ▄▄         ▀████    '
        _l5='   ███▀  ████▄▄        ▀███   '; _l6='  ███▀    ▀▀████▄       ▀███  '
        _l7=' ▄███        ▀█████▄     ███▄ '; _l8=' ████           █████    ████ '
        _l9=' ▀███        ▄█████▀     ███▀ '; _l10='  ████▄   ▄▄████▀      ▄████  '
        _l11='  ██████ ████▀▀       ██████  '; _l12='  ▀█████▄ ▀▀         ▄█████▀  '
        _l13='     ▀█████▄▄▄▄▄▄▄▄█████▀     '; _l14='        ▀▀██████████▀▀        '
        _l15='             ▀▀▀▀             '
    else
        _l1='             ####             '; _l2='         ############         '
        _l3='      ##################      '; _l4='    ####              ####    '
        _l5='   ####  #####         ####   '; _l6='  ###      ######        ###  '
        _l7='  ###         #####      ###  '; _l8=' ####           #####    #### '
        _l9='  ###         #####      ###  '; _l10='  #####    ######      #####  '
        _l11='  ###### #####        ######  '; _l12='  ######              ######  '
        _l13='      ######      ######      '; _l14='         ############         '
        _l15='                              '
    fi
    for _ln in "$_l1" "$_l2" "$_l3" "$_l4" "$_l5" "$_l6" "$_l7" "$_l8" "$_l9" "$_l10" "$_l11" "$_l12" "$_l13" "$_l14" "$_l15"; do
        printf "  %b%s%b\n" "$_UMO_PRI" "$_ln" "$_UMO_NC"
    done
    printf "\n"

    printf "  %b%s%b  Initializing UMO Services...\n" "$_UMO_PRI" "$_G_RUN" "$_UMO_NC"

    _vnc_log="$UMO_SCRIPT_HOME/logs/vnc-start.log"
    mkdir -p "$UMO_SCRIPT_HOME/logs" 2>/dev/null || true
    : > "$_vnc_log" 2>/dev/null || true
    nohup "$UMO_LOGIN" -c "umo-startvnc" > "$_vnc_log" 2>&1 &
    _vnc_starter=$!

    _vnc_wait=0
    while [ "$_vnc_wait" -lt 90 ]; do
        if pgrep -f Xvnc >/dev/null 2>&1 || pgrep -f Xtigervnc >/dev/null 2>&1; then
            break
        fi
        kill -0 "$_vnc_starter" 2>/dev/null || break
        sleep 1
        _vnc_wait=$((_vnc_wait + 1))
    done

    IP=$(ip route get 1 2>/dev/null | awk '{print $7; exit}')
    [ -z "$IP" ] && IP="127.0.0.1"

    printf "\033[1A\033[2K"
    if ! pgrep -f Xvnc >/dev/null 2>&1 && ! pgrep -f Xtigervnc >/dev/null 2>&1; then
        printf "  %b────────────────────────────────────────%b\n" "$_UMO_PRI" "$_UMO_NC"
        printf "  %b%b▸ VNC Failed To Start%b\n" "$_UMO_BOLD" "$_UMO_RED" "$_UMO_NC"
        printf "  %b────────────────────────────────────────%b\n" "$_UMO_PRI" "$_UMO_NC"
        printf "\n"
        printf "  %bLast log lines:%b\n" "$_UMO_DIM" "$_UMO_NC"
        if [ ! -s "$_vnc_log" ]; then
            if kill -0 "$_vnc_starter" 2>/dev/null; then
                printf "    (the starter is running but no X server appeared in %ss)\n" "$_vnc_wait"
            else
                printf "    (the starter exited without producing any output -\n"
                printf "     on Android 12+ this is usually the phantom process killer;\n"
                printf "     apply the one-time adb fix below, then re-run: umo start)\n"
            fi
        fi
        tail -n 8 "$_vnc_log" 2>/dev/null | while IFS= read -r _line; do
            printf "    %s\n" "$_line"
        done
        printf "\n"
        printf "  %bHint:%b      %bumo login -c \"apt install -y tigervnc-standalone-server\"%b\n" "$_UMO_BOLD" "$_UMO_NC" "$_UMO_CYN" "$_UMO_NC"
        printf "  %bLog:%b       %b%s%b\n" "$_UMO_BOLD" "$_UMO_NC" "$_UMO_CYN" "$(_umo_dp "$_vnc_log")" "$_UMO_NC"
        printf "\n"
        printf "  %bAndroid 12+ note:%b\n" "$_UMO_BOLD" "$_UMO_NC"
        printf "  %bAndroid kills background sessions (phantom processes). One-time fix from a PC:%b\n" "$_UMO_DIM" "$_UMO_NC"
        printf "  %badb shell device_config put activity_manager max_phantom_processes 2147483647%b\n" "$_UMO_CYN" "$_UMO_NC"
        printf "  %badb shell settings put global settings_enable_monitor_phantom_procs false%b\n" "$_UMO_CYN" "$_UMO_NC"
        printf "\n"
        exit 1
    fi

    printf "  %b────────────────────────────────────────%b\n" "$_UMO_PRI" "$_UMO_NC"
    printf "  %b%b▸ UMO Session Active%b\n" "$_UMO_BOLD" "$_UMO_GRN" "$_UMO_NC"
    printf "  %b────────────────────────────────────────%b\n" "$_UMO_PRI" "$_UMO_NC"
    printf "\n"
    printf "  %bVNC:%b       %b%s:5901%b\n" "$_UMO_BOLD" "$_UMO_NC" "$_UMO_CYN" "$IP" "$_UMO_NC"
    printf "  %bStop:%b      %bumo stop%b\n" "$_UMO_BOLD" "$_UMO_NC" "$_UMO_CYN" "$_UMO_NC"
    printf "  %bStatus:%b    %bumo status%b\n" "$_UMO_BOLD" "$_UMO_NC" "$_UMO_CYN" "$_UMO_NC"
    printf "\n"
    printf "  %b────────────────────────────────────────%b\n" "$_UMO_PRI" "$_UMO_NC"
    printf "\n"
fi

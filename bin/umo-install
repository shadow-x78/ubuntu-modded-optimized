#!/bin/sh

set -e
unset LD_PRELOAD

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
export UMO_LIB_DIR="$SCRIPT_DIR/lib"
export UMO_MOD_DIR="$SCRIPT_DIR/modules"
export UMO_VERSION="4.18.2"

UMO_INSTALL_DIR="${UMO_INSTALL_DIR:-$HOME/umo-ubuntu}"
UMO_RUNTIME_DIR="${UMO_RUNTIME_DIR:-$HOME/.umo}"
UMO_SCRIPT_DIR="${UMO_SCRIPT_DIR:-$UMO_RUNTIME_DIR}"
UMO_UBUNTU_VERSION="${UMO_UBUNTU_VERSION:-22.04}"
UMO_DE="${UMO_DE:-xfce4}"
UMO_APP_SET="${UMO_APP_SET:-basic}"
UMO_PERF_MODE="${UMO_PERF_MODE:-balanced}"
UMO_THEME="${UMO_THEME:-umo-dark}"
UMO_LEAN="${UMO_LEAN:-0}"
UMO_NON_INTERACTIVE="${UMO_NON_INTERACTIVE:-}"
UMO_LOGIN_SH="$UMO_RUNTIME_DIR/umo-login.sh"

export UMO_INSTALL_DIR UMO_RUNTIME_DIR UMO_SCRIPT_DIR UMO_LOGIN_SH UMO_UBUNTU_VERSION UMO_DE UMO_APP_SET UMO_PERF_MODE UMO_THEME UMO_LEAN UMO_NON_INTERACTIVE

. "$UMO_LIB_DIR/core-ansi.sh"
. "$UMO_LIB_DIR/core-ui.sh"
. "$UMO_LIB_DIR/core-system.sh"
. "$UMO_LIB_DIR/core-net.sh"
. "$UMO_LIB_DIR/core-fs.sh"

. "$UMO_MOD_DIR/umo-proot.sh"
. "$UMO_MOD_DIR/umo-vnc.sh"
. "$UMO_MOD_DIR/umo-audio.sh"
. "$UMO_MOD_DIR/umo-systemctl.sh"
. "$UMO_MOD_DIR/umo-desktop.sh"
. "$UMO_MOD_DIR/umo-apps.sh"

umo_login_sh() {
    printf '%s' "${UMO_LOGIN_SH:-$HOME/.umo/umo-login.sh}"
}

umo_esc_sed() {
    printf '%s' "$1" | sed -e 's/[\\&|"]/\\&/g'
}

umo_render_cli() {
    _src="$1"
    _dst="$2"
    _v_esc=$(umo_esc_sed "$UMO_VERSION")
    _repo_esc=$(umo_esc_sed "$SCRIPT_DIR")
    _rt_esc=$(umo_esc_sed "$UMO_RUNTIME_DIR")
    if sed -e "s|@@UMO_VERSION@@|$_v_esc|g" \
        -e "s|@@UMO_REPO_DIR@@|$_repo_esc|g" \
        -e "s|@@UMO_RUNTIME_DIR@@|$_rt_esc|g" \
        "$_src" > "$_dst.new" 2>/dev/null && [ -s "$_dst.new" ]; then
        mv -f "$_dst.new" "$_dst" 2>/dev/null || { rm -f "$_dst.new"; return 1; }
        chmod +x "$_dst" 2>/dev/null || true
        return 0
    fi
    rm -f "$_dst.new" 2>/dev/null || true
    return 1
}

umo_write_aliases() {
    _aliases_file="$UMO_SCRIPT_DIR/aliases.sh"
    mkdir -p "$UMO_SCRIPT_DIR" 2>/dev/null || true
    cat > "$_aliases_file" << ALIASES
alias umo-start='${UMO_SCRIPT_DIR}/umo-start.sh'
alias umo-stop='${UMO_SCRIPT_DIR}/umo-stop.sh'
alias umo-startvnc='${UMO_SCRIPT_DIR}/umo-vnc-start.sh'
alias umo-stopvnc='${UMO_SCRIPT_DIR}/umo-vnc-stop.sh'
alias umo-login='${UMO_SCRIPT_DIR}/umo-login.sh'
alias umo-user='${UMO_SCRIPT_DIR}/umo-user.sh'
ALIASES

    for _rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
        [ -f "$_rc" ] || continue
        sed -i -e '/# ===== UMO =====/,+1d' "$_rc" 2>/dev/null || true
        printf '\n# ===== UMO =====\n[ -f "%s/aliases.sh" ] && . "%s/aliases.sh"\n' "$UMO_SCRIPT_DIR" "$UMO_SCRIPT_DIR" >> "$_rc" 2>/dev/null || true
    done
    umo_log_ok "Host aliases written to $(umo_fs_display_path "$UMO_SCRIPT_DIR")/aliases.sh"
}

umo_phase_check() {
    umo_ui_init
    umo_ui_header "System Check"
    umo_sys_require_termux
    umo_sys_setup_storage
    umo_sys_require_arch
    umo_sys_require_internet
    umo_sys_require_space 2048
    umo_sys_summary
}

umo_phase_deps() {
    umo_ui_header "Dependencies"
    _install_deps() {
        _pkg_cmd="apt-get install -y"
        command -v pkg >/dev/null 2>&1 && _pkg_cmd="pkg install -y"
        $_pkg_cmd proot-distro wget tar pulseaudio x11-repo tur-repo git curl unzip >/dev/null 2>&1 || true
        $_pkg_cmd virglrenderer-android termux-x11-nightly >/dev/null 2>&1 || true
        return 0
    }
    umo_run_quiet "Installing Dependencies" _install_deps || \
        umo_log_warn "Some dependencies could not be installed yet"
    return 0
}

umo_phase_config() {
    if [ -n "$UMO_NON_INTERACTIVE" ]; then
        umo_log_info "Non-interactive mode: DE=$UMO_DE, Apps=$UMO_APP_SET"
        return 0
    fi

    umo_ui_menu "Choose Ubuntu Version" \
        "Ubuntu 22.04 LTS (Jammy - Stable, Recommended)" \
        "Ubuntu 24.04 LTS (Noble - Latest)"

    case "$UMO_MENU_IDX" in
        1) UMO_UBUNTU_VERSION="22.04" ;;
        2) UMO_UBUNTU_VERSION="24.04" ;;
    esac

    umo_ui_menu "Choose Desktop Environment" \
        "XFCE4 (Recommended - Balanced)" \
        "LXDE (Ultra-Lightweight)" \
        "Openbox (Minimal - Advanced)" \
        "Minimal (CLI Only - No GUI)"

    case "$UMO_MENU_IDX" in
        1) UMO_DE="xfce4" ;;
        2) UMO_DE="lxde" ;;
        3) UMO_DE="openbox" ;;
        4) UMO_DE="minimal" ;;
    esac

    umo_ui_menu "Choose Theme Mode" \
        "Night Mode - Dark Theme (Orchis-Dark, Recommended)" \
        "Day Mode - Light Theme (Orchis-Light)"

    case "$UMO_MENU_IDX" in
        2) UMO_THEME="umo-light" ;;
        *) UMO_THEME="umo-dark" ;;
    esac

    umo_ui_menu "Choose Application Set" \
        "Basic (Utilities + Falkon Browser + Fastfetch)" \
        "Developer (Basic + Python/Node/GCC + VS Code/Geany)" \
        "Media (Basic + VLC/FFmpeg/GIMP/Audacity)" \
        "Office (Basic + LibreOffice Suite)" \
        "Browser (Basic + Falkon)" \
        "Full Suite (Everything)"

    case "$UMO_MENU_IDX" in
        1) UMO_APP_SET="basic" ;;
        2) UMO_APP_SET="dev" ;;
        3) UMO_APP_SET="media" ;;
        4) UMO_APP_SET="office" ;;
        5) UMO_APP_SET="browser" ;;
        6) UMO_APP_SET="full" ;;
    esac

    umo_ui_header "Configuration Summary"
    umo_kv "Desktop" "$UMO_DE"
    umo_kv "Apps"    "$UMO_APP_SET"
    umo_kv "Theme"   "$UMO_THEME"
    umo_kv "Install" "$(umo_fs_display_path "$UMO_INSTALL_DIR")"
    umo_kv "Version" "Ubuntu $UMO_UBUNTU_VERSION"
    umo_kv "Timezone" "${UMO_TZ:-Etc/UTC} (Device)"

    umo_ui_confirm "Confirm installation?" "Y" || {
        umo_log_info "Installation cancelled."
        exit 0
    }
}

umo_phase_download() {
    umo_ui_header "Ubuntu RootFS"
    export UMO_CACHE_DIR="$HOME/.umo/cache"
    if ! mkdir -p "$UMO_CACHE_DIR" 2>/dev/null; then
        umo_die "Cannot create cache directory: $(umo_fs_display_path "$UMO_CACHE_DIR")"
    fi

    _arch=$(uname -m)
    case "$_arch" in
        aarch64|arm64) _uarch="arm64" ;;
        armv7l|armv8l|arm) _uarch="armhf" ;;
        *) _uarch="arm64" ;;
    esac

    _archive="$UMO_CACHE_DIR/umo-rootfs-${UMO_UBUNTU_VERSION}-${_uarch}.tar.gz"
    umo_net_download_mirrors "$_archive"
    [ -f "$_archive" ] || umo_die "Download reported success but archive is missing: $(umo_fs_display_path "$_archive")"
    umo_net_extract "$_archive" "$UMO_INSTALL_DIR"
    rm -f "$_archive"

    if [ ! -f "$UMO_INSTALL_DIR/bin/bash" ] || [ ! -f "$UMO_INSTALL_DIR/bin/sh" ]; then
        umo_die "RootFS extraction failed: /bin/bash or /bin/sh not found. Try a different mirror"
    fi
    if [ ! -f "$UMO_INSTALL_DIR/usr/share/zoneinfo/${UMO_TZ:-Etc/UTC}" ]; then
        umo_log_warn "Device timezone '${UMO_TZ:-unknown}' not in rootfs, falling back to Etc/UTC"
        UMO_TZ="Etc/UTC"
        export UMO_TZ
    fi
    umo_log_ok "RootFS integrity verified"
}

umo_phase_proot() {
    umo_ui_header "Proot Container"
    umo_run_quiet "Configuring Proot Container..." umo_proot_setup || \
        umo_die "Proot container setup failed - check ~/.umo/logs/ for details"
    umo_run_quiet "Setting Up Container User..." umo_proot_create_user || \
        umo_log_warn "Container user setup finished with warnings"
    return 0
}

umo_phase_vnc() {
    [ "$UMO_DE" = "minimal" ] && { umo_log_info "Skipping VNC (minimal mode)."; return 0; }
    umo_ui_header "VNC Server"
    umo_vnc_setup || umo_log_warn "VNC setup finished with warnings (installation continues)"
    return 0
}

umo_phase_audio() {
    umo_ui_header "Audio Bridge"
    umo_run_quiet "Configuring Audio Bridge..." umo_audio_setup || \
        umo_log_warn "Audio bridge setup finished with warnings"
    return 0
}

umo_phase_systemctl() {
    umo_ui_header "Systemctl Emulator"
    umo_run_quiet "Configuring Systemctl Emulator..." umo_systemctl_setup || \
        umo_log_warn "Systemctl emulator setup finished with warnings"
    return 0
}

umo_phase_desktop() {
    [ "$UMO_DE" = "minimal" ] && { umo_log_info "Skipping desktop (minimal mode)."; return 0; }
    umo_ui_header "Desktop Environment"
    umo_de_install || umo_log_warn "Desktop installation finished with warnings"
    return 0
}

umo_phase_apps() {
    umo_ui_header "Applications"
    umo_apps_install || umo_log_warn "Application installation finished with warnings"
    return 0
}

umo_phase_finalize() {
    umo_ui_header "Finalizing"

    if _umo_apply_tz_files "$UMO_INSTALL_DIR" "${UMO_TZ:-Etc/UTC}"; then
        umo_log_ok "Timezone Synced From Device (${UMO_TZ:-Etc/UTC})"
    else
        umo_log_warn "Could Not Apply Device Timezone (Using RootFS Default)"
    fi

    if [ "$UMO_DE" != "minimal" ] && [ -x "$(umo_login_sh)" ]; then
        _fin_probe="startxfce4"
        [ "$UMO_DE" = "lxde" ] && _fin_probe="startlxde"
        [ "$UMO_DE" = "openbox" ] && _fin_probe="openbox-session"
        [ "$UMO_DE" = "minimal" ] && _fin_probe="xterm"
        if ! "$(umo_login_sh)" -c "command -v $_fin_probe >/dev/null 2>&1"; then
            umo_log_warn "Desktop component '$_fin_probe' missing - retrying desktop install..."
            umo_de_install || true
        fi
    fi

    _umo_finalize_codename="jammy"
    [ "$UMO_UBUNTU_VERSION" = "24.04" ] && _umo_finalize_codename="noble"
    umo_run_quiet "Configuring APT Sources..." sh -c "printf '%s\n' \
        'deb [trusted=yes] http://ports.ubuntu.com/ubuntu-ports ${_umo_finalize_codename} main restricted universe multiverse' \
        'deb [trusted=yes] http://ports.ubuntu.com/ubuntu-ports ${_umo_finalize_codename}-updates main restricted universe multiverse' \
        'deb [trusted=yes] http://ports.ubuntu.com/ubuntu-ports ${_umo_finalize_codename}-backports main restricted universe multiverse' \
        'deb [trusted=yes] http://ports.ubuntu.com/ubuntu-ports ${_umo_finalize_codename}-security main restricted universe multiverse' \
        > \"$UMO_INSTALL_DIR/etc/apt/sources.list\"" || true
    _umo_cli_login="$(umo_login_sh)"
    if [ -x "$_umo_cli_login" ]; then
        _umo_login_timeout() {
            _umo_login_t="$1"
            shift
            if command -v timeout >/dev/null 2>&1; then
                timeout "$_umo_login_t" "$(umo_login_sh)" "$@" </dev/null
            else
                "$(umo_login_sh)" "$@" </dev/null
            fi
        }
        umo_run_stream "Installing Dependencies..." _umo_login_timeout 600 -c \
            "export DEBIAN_FRONTEND=noninteractive; apt-get install -y --no-install-recommends sudo >/tmp/umo-bootstrap.log 2>&1 || true" || true
        umo_run_stream "Configuring Packages..." _umo_login_timeout 900 -c \
            "export DEBIAN_FRONTEND=noninteractive; dpkg --configure -a >/tmp/umo-bootstrap.log 2>&1 || true" || true
        umo_run_quiet "Setting Up Users..." _umo_login_timeout 120 -c "usermod -aG sudo umo" || true
        umo_run_quiet "Restoring Service Binaries..." _umo_login_timeout 120 -c '
            for _f in invoke-rc.d service systemctl; do
                if [ -L "/usr/sbin/$_f" ] && [ -f "/usr/sbin/$_f.real" ]; then
                    rm -f "/usr/sbin/$_f"
                    mv "/usr/sbin/$_f.real" "/usr/sbin/$_f"
                fi
            done
            true
        ' || true
        umo_run_quiet "Hardening Package Manager Config..." _umo_login_timeout 120 -c '
            cat > /etc/apt/apt.conf.d/99-umo-sandbox << "UMOAPT"
APT::Sandbox::User "root";
Dpkg::Options:: "--force-confdef";
Dpkg::Options:: "--force-confold";
Dpkg::Use-Pty "0";
DPkg::FlushSTDIN "false";
UMOAPT
            chmod 644 /etc/apt/apt.conf.d/99-umo-sandbox
        ' || true
    fi

    _cplt_body='export DEBIAN_FRONTEND=noninteractive
_apt_filter() { grep -v "^Ign\|^Get:\|^Preparing\|^Unpacking\|^Selecting\|^Setting up\|^Processing\|^Reading\|^Building\|^Creating\|^debconf:" || true; }
timeout 300 dpkg --configure -a 2>&1 | _apt_filter || true
_broken=$(dpkg -l 2>/dev/null | awk "/^iU|^iF|^hF/{print \$2}")
if [ -n "$_broken" ]; then
    for _pkg in $_broken; do
        dpkg --remove --force-depends "$_pkg" 2>&1 | _apt_filter || true
    done
    timeout 300 apt-get -f install -y 2>&1 | _apt_filter || true
    timeout 300 dpkg --configure -a 2>&1 | _apt_filter || true
fi'
    if [ -x "$_umo_cli_login" ]; then
        umo_run_stream "Configuring Any Remaining Packages..." "$_umo_cli_login" -c "$_cplt_body" || true
        umo_run_quiet "Cleaning Dpkg Locks..." "$_umo_cli_login" -c "rm -f /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend 2>/dev/null || true" || true
    fi

    for _rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
        if [ -f "$_rc" ]; then
            sed -i -e '/alias umo=/d' -e '/alias startvnc=/d' -e '/alias stopvnc=/d' "$_rc" 2>/dev/null || true
        fi
    done

    for _proc in proot dbus-daemon pulseaudio Xvnc Xtigervnc termux-x11 dconf-service xfce4-session gpg-agent dirmngr; do
        pkill -9 -f "$_proc" 2>/dev/null || true
    done

    mkdir -p "$UMO_SCRIPT_DIR" 2>/dev/null || {
        umo_log_warn "Cannot create $(umo_fs_display_path "$UMO_SCRIPT_DIR"), host scripts stay where they are"
        UMO_SCRIPT_DIR="$HOME"
    }
    for _script in start stop; do
        _src="$SCRIPT_DIR/bin/umo-$_script"
        _dst="$UMO_SCRIPT_DIR/umo-$_script.sh"
        if [ -f "$_src" ]; then
            cp -f "$_src" "$_dst" 2>/dev/null || {
                umo_log_warn "Could not install umo-$_script.sh"
                continue
            }
            chmod +x "$_dst" 2>/dev/null || true
        fi
    done

    for _old in "$HOME/umo-login.sh" "$HOME/umo-user.sh" "$HOME/umo-start.sh" "$HOME/umo-stop.sh" "$HOME/umo-vnc-start.sh" "$HOME/umo-vnc-stop.sh"; do
        [ "$_old" = "$UMO_SCRIPT_DIR/$(basename "$_old")" ] && continue
        rm -f "$_old" 2>/dev/null || true
    done

    umo_write_aliases

    _umo_cli_dir="$(cd "$HOME/.." 2>/dev/null && pwd)/usr/bin"
    _umo_cli_target="$_umo_cli_dir/umo"
    if [ ! -d "$_umo_cli_dir" ] && ! mkdir -p "$_umo_cli_dir" 2>/dev/null; then
        umo_log_warn "Termux bin directory not found, 'umo' command wrapper skipped"
        _umo_cli_target=""
    fi

    if [ -n "$_umo_cli_target" ]; then
        _umo_cli_src="$SCRIPT_DIR/bin/umo-cli"
        if [ -f "$_umo_cli_src" ]; then
            if umo_render_cli "$_umo_cli_src" "$_umo_cli_target"; then
                umo_log_ok "CLI command installed ($(umo_fs_display_path "$_umo_cli_target"))"
            else
                umo_log_warn "CLI wrapper render failed, keeping current CLI if any"
            fi
        else
            umo_log_warn "bin/umo-cli template missing, 'umo' command wrapper skipped"
            _umo_cli_target=""
        fi
    fi

    umo_fs_mkdir "$UMO_RUNTIME_DIR" 2>/dev/null || true
    if [ -d "$UMO_RUNTIME_DIR" ]; then
        {
            printf 'UMO_UBUNTU_VERSION="%s"\n' "$UMO_UBUNTU_VERSION"
            printf 'UMO_DE="%s"\n' "$UMO_DE"
            printf 'UMO_APP_SET="%s"\n' "$UMO_APP_SET"
            printf 'UMO_THEME="%s"\n' "$UMO_THEME"
            printf 'UMO_PERF_MODE="%s"\n' "$UMO_PERF_MODE"
            printf 'UMO_LEAN="%s"\n' "$UMO_LEAN"
            printf 'INSTALL_DIR="%s"\n' "$UMO_INSTALL_DIR"
            printf 'UMO_USER="umo"\n'
            printf 'REPO_DIR="%s"\n' "$SCRIPT_DIR"
        } > "$UMO_RUNTIME_DIR/umo.conf"
        umo_log_ok "Installation settings saved ($(umo_fs_display_path "$UMO_RUNTIME_DIR")/umo.conf)"
    fi

    umo_log_ok "Finalized"
    return 0
}

umo_phase_summary() {
    umo_screen_clear
    umo_banner || true
    umo_rule

    printf "\n  %b%s%b  %b%bInstallation Complete%b\n" "$UMO_COLOR_PRIMARY" "$UMO_G_STEP_BLOCK" "$UMO_NC" "$UMO_BOLD" "$UMO_COLOR_SUCCESS" "$UMO_NC"
    printf "  %b" "$UMO_COLOR_PRIMARY"
    umo_repeat "$UMO_LINE_H" 24
    printf "%b\n\n" "$UMO_NC"

    umo_kv "Version" "Ubuntu $UMO_UBUNTU_VERSION"
    umo_kv "Desktop" "$UMO_DE"
    umo_kv "Theme"   "$UMO_THEME"
    umo_kv "Apps"    "$UMO_APP_SET"
    umo_kv "Timezone" "${UMO_TZ:-Etc/UTC} (Device)"
    umo_kv "Path"    "$(umo_fs_display_path "$UMO_INSTALL_DIR")"

    termux-wake-unlock >/dev/null 2>&1 || true
    _vnc_pass="${UMO_VNC_PASSWORD:-}"
    if [ -z "$_vnc_pass" ] && [ -s "$UMO_RUNTIME_DIR/vnc-pass" ]; then
        _vnc_pass="$(tr -d '\r\n' < "$UMO_RUNTIME_DIR/vnc-pass" 2>/dev/null || true)"
    fi
    if [ -n "$_vnc_pass" ]; then
        umo_kv "VNC"     "127.0.0.1:5901 (pass: $_vnc_pass)"
    else
        umo_kv "VNC"     "127.0.0.1:5901 (pass: see $(umo_fs_display_path "$UMO_RUNTIME_DIR")/vnc-pass)"
    fi
    umo_kv "User"    "umo (login pass: umo)"

    printf "\n  %b%s%b  %b%bGet Started%b\n" "$UMO_COLOR_PRIMARY" "$UMO_G_STEP_BLOCK" "$UMO_NC" "$UMO_BOLD" "$UMO_COLOR_PRIMARY" "$UMO_NC"
    printf "  %b" "$UMO_COLOR_PRIMARY"
    umo_repeat "$UMO_LINE_H" 14
    printf "%b\n\n" "$UMO_NC"

    printf "  %b%-30s%b %s\n" "$UMO_B_CYAN" "umo start" "$UMO_NC" "Start UMO session & VNC"
    printf "  %b%-30s%b %s\n" "$UMO_B_CYAN" "umo stop" "$UMO_NC" "Stop all services"
    printf "  %b%-30s%b %s\n" "$UMO_B_CYAN" "umo vnc" "$UMO_NC" "Start the VNC server only"
    printf "  %b%-30s%b %s\n" "$UMO_B_CYAN" "umo status" "$UMO_NC" "Show service status"
    printf "  %b%-30s%b %s\n" "$UMO_B_CYAN" "umo login" "$UMO_NC" "Login as root"
    printf "  %b%-30s%b %s\n" "$UMO_B_CYAN" "umo user" "$UMO_NC" "Login as default user"
    printf "  %b%-30s%b %s\n" "$UMO_B_CYAN" "umo run \"<cmd>\"" "$UMO_NC" "Run one command in Ubuntu"
    printf "  %b%-30s%b %s\n" "$UMO_B_CYAN" "umo --user <name>" "$UMO_NC" "Switch default user"
    printf "  %b%-30s%b %s\n" "$UMO_B_CYAN" "umo backup" "$UMO_NC" "Backup system rootfs"
    printf "  %b%-30s%b %s\n" "$UMO_B_CYAN" "umo update" "$UMO_NC" "Update UMO tool"
    printf "  %b%-30s%b %s\n" "$UMO_B_CYAN" "umo uninstall" "$UMO_NC" "Remove UMO completely"

    _readme_dir="$UMO_INSTALL_DIR/root/.umo"
    umo_fs_mkdir "$_readme_dir" 2>/dev/null || true
    timeout 5 sh -c 'cat > "$1" 2>/dev/null' _ "$_readme_dir/README.txt" << README_EOF || true
========================================
  UMO Ubuntu - v$UMO_VERSION
  Version: $UMO_UBUNTU_VERSION
  Desktop: $UMO_DE
========================================

Commands (run from Termux):
  umo start           Start UMO session & VNC
  umo stop            Stop all services
  umo vnc             Start the VNC server only
  umo status          Show service status
  umo login           Login as root
  umo user            Login as default user
  umo run "<cmd>"     Run one command in Ubuntu
  umo --user <name>   Switch default user
  umo backup          Backup system rootfs
  umo update          Update UMO tool
  umo uninstall       Remove UMO completely

VNC: 127.0.0.1:5901 (connect with a VNC viewer on this device)
User: umo (Login pass: umo, VNC pass: ${_vnc_pass:-see $UMO_RUNTIME_DIR/vnc-pass})

========================================
README_EOF

    printf "\n  %bRun %bumo --help%b%b for the full command reference.%b\n\n" "$UMO_DIM" "$UMO_B_CYAN" "$UMO_NC" "$UMO_DIM" "$UMO_NC"
}

umo_cli_parse() {
    for _arg in "$@"; do
        case "$_arg" in
            --no-gui|--non-interactive) UMO_NON_INTERACTIVE=1 ;;
            --refresh) UMO_REFRESH=1 ;;
            --de=*)      UMO_DE="${_arg#*=}" ;;
            --apps=*)    UMO_APP_SET="${_arg#*=}" ;;
            --dir=*)
                UMO_INSTALL_DIR="${_arg#*=}"
                _umo_tilde='~'
                if [ "$UMO_INSTALL_DIR" = "$_umo_tilde" ]; then
                    UMO_INSTALL_DIR="$HOME"
                else
                    case "$UMO_INSTALL_DIR" in
                        "$_umo_tilde"/*) UMO_INSTALL_DIR="$HOME/${UMO_INSTALL_DIR#"$_umo_tilde/"}" ;;
                    esac
                fi
                case "$UMO_INSTALL_DIR" in
                    *[!A-Za-z0-9_./-]*)
                        umo_log_err "Invalid --dir value: $UMO_INSTALL_DIR"
                        umo_die "Allowed characters: letters, digits, dot, underscore, hyphen, slash"
                        ;;
                esac
                ;;
            --ubuntu=*)  UMO_UBUNTU_VERSION="${_arg#*=}" ;;
            --version=*) UMO_UBUNTU_VERSION="${_arg#*=}" ;;
            --perf=*)    UMO_PERF_MODE="${_arg#*=}" ;;
            --theme=*)   UMO_THEME="${_arg#*=}" ;;
            --mode=*)    UMO_THEME="${_arg#*=}" ;;
            --lean)      UMO_LEAN=1 ;;
            --help|-h)
                printf "\n  %bUbuntu Modded Optimized (UMO) Installer%b\n\n" "$UMO_BOLD" "$UMO_NC"
                printf "  %bUSAGE:%b\n" "$UMO_BOLD" "$UMO_NC"
                printf "    %bumo-install%b [OPTIONS]\n\n" "$UMO_B_CYAN" "$UMO_NC"

                printf "  %bOPTIONS:%b\n" "$UMO_BOLD" "$UMO_NC"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "-h, --help" "$UMO_NC" "Print help information"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--no-gui, --non-interactive" "$UMO_NC" "Run in non-interactive mode"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--lean" "$UMO_NC" "Remove docs/man/locales to save space"
                printf "\n"

                printf "  %bCONFIGURATION:%b\n" "$UMO_BOLD" "$UMO_NC"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--de=<env>" "$UMO_NC" "Desktop environment (xfce4, lxde, openbox)"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--apps=<set>" "$UMO_NC" "Application set (basic, dev, media, office, browser, full)"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--dir=<path>" "$UMO_NC" "Installation directory"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--ubuntu=<version>" "$UMO_NC" "Ubuntu version (22.04, 24.04)"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--perf=<mode>" "$UMO_NC" "Performance level (balanced, aggressive, off) [default: balanced]"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--theme=<theme>" "$UMO_NC" "Desktop theme (umo-dark, umo-light, none)"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--mode=<mode>" "$UMO_NC" "Theme mode alias (dark, light)"
                printf "\n"

                printf "  %bEXAMPLES:%b\n" "$UMO_BOLD" "$UMO_NC"
                printf "    %b\$ umo-install --no-gui --de=xfce4 --apps=full%b\n" "$UMO_DIM" "$UMO_NC"
                printf "    %b\$ umo-install --dir=\$HOME/ubuntu%b\n\n" "$UMO_DIM" "$UMO_NC"
                exit 0
                ;;
        esac
    done
}

. "$UMO_MOD_DIR/umo-perf.sh" 2>/dev/null || true

umo_phase_perf() {
    [ "$UMO_PERF_MODE" = "off" ] && { umo_log_info "Performance tuning disabled."; return 0; }
    umo_ui_header "Performance Tuning"
    if command -v umo_perf_setup >/dev/null 2>&1; then
        umo_perf_setup || umo_log_warn "Performance tuning finished with warnings"
        umo_log_ok "Performance optimizations applied (mode: $UMO_PERF_MODE)"
    else
        umo_log_warn "Performance module not available, skipping"
    fi
    return 0
}

. "$UMO_MOD_DIR/umo-theme.sh" 2>/dev/null || true

umo_phase_theme() {
    [ "$UMO_THEME" = "none" ] && { umo_log_info "Theme disabled."; return 0; }
    umo_ui_header "Desktop Theme"
    export SCRIPT_DIR
    if command -v umo_theme_setup >/dev/null 2>&1; then
        umo_theme_setup || umo_log_warn "Theme setup finished with warnings"
        umo_log_ok "Desktop theme applied ($UMO_THEME)"
    else
        umo_log_warn "Theme module not available, skipping"
    fi
    return 0
}

umo_main() {
    umo_cli_parse "$@"

    if [ "${UMO_REFRESH:-0}" = "1" ]; then
        if [ ! -x "$(umo_login_sh)" ]; then
            umo_log_err "UMO is not installed yet - run the installer first."
            exit 1
        fi
        _umo_cli_src="$SCRIPT_DIR/bin/umo-cli"
        if [ ! -f "$_umo_cli_src" ]; then
            umo_log_err "bin/umo-cli template missing, cannot refresh tools."
            exit 1
        fi
        _umo_refresh_tmp=""
        if command -v mktemp >/dev/null 2>&1; then
            _umo_refresh_tmp=$(mktemp "${TMPDIR:-/tmp}/umo-refresh.XXXXXX" 2>/dev/null || true)
        fi
        [ -n "$_umo_refresh_tmp" ] || _umo_refresh_tmp="${TMPDIR:-/tmp}/umo-refresh.$$.sh"
        if ! umo_render_cli "$_umo_cli_src" "$_umo_refresh_tmp"; then
            rm -f "$_umo_refresh_tmp" 2>/dev/null || true
            umo_log_err "Could not render the refresh wrapper, aborting."
            exit 1
        fi
        _umo_refresh_rc=0
        (
            unset UMO_DE UMO_THEME UMO_APP_SET UMO_UBUNTU_VERSION UMO_PERF_MODE \
                  UMO_LEAN UMO_INSTALL_DIR UMO_LOGIN_SH UMO_NON_INTERACTIVE
            sh "$_umo_refresh_tmp" refresh
        ) || _umo_refresh_rc=$?
        rm -f "$_umo_refresh_tmp" 2>/dev/null || true
        exit "$_umo_refresh_rc"
    fi

    _umo_exit_code=0
    _umo_sigint_cleanup() {
        _umo_exit_code=${_umo_exit_code:-130}
        trap - EXIT INT TERM HUP
        for _sig in INT TERM HUP; do trap "" "$_sig"; done
        if [ -n "${_UMO_SPINNER_PID:-}" ]; then
            kill -KILL "$_UMO_SPINNER_PID" 2>/dev/null || true
        fi
        _inst_dir="${UMO_INSTALL_DIR:-$HOME/umo-ubuntu}"
        _inst_re=$(printf '%s' "$_inst_dir" | sed 's/[][\\.*^$()+?{|/]/\\&/g')
        _login_re=$(printf '%s' "$(umo_login_sh)" | sed 's/[][\\.*^$()+?{|/]/\\&/g')
        timeout 5 sh -c "
            pkill -KILL -f 'proot.*${_inst_re}'      2>/dev/null || true
            pkill -KILL -f '${_login_re}'              2>/dev/null || true
            pkill -KILL -f 'install-vnc.sh'             2>/dev/null || true
            pkill -KILL -f 'install-de.sh'              2>/dev/null || true
            pkill -KILL -f 'install-theme.sh'           2>/dev/null || true
            pkill -KILL -f 'debloat.sh'                 2>/dev/null || true
            pkill -KILL -f 'cleanup.sh'                 2>/dev/null || true
            pkill -KILL -f 'perf-desktop.sh'            2>/dev/null || true
            pkill -KILL -f 'divert-triggers.sh'         2>/dev/null || true
            pkill -KILL -f 'apt-get'                     2>/dev/null || true
            pkill -KILL -f 'dpkg'                        2>/dev/null || true
        " 2>/dev/null || true
        printf '\033[?25h' 2>/dev/null || true
        exit "$_umo_exit_code"
    }
    trap _umo_sigint_cleanup EXIT INT TERM HUP

    case "$UMO_THEME" in
        umo-dark|umo-light|none|'') ;;
        dark|night) UMO_THEME="umo-dark" ;;
        light|day)  UMO_THEME="umo-light" ;;
        *) UMO_THEME="umo-dark" ;;
    esac

    UMO_TZ="$(_umo_detect_tz)"
    export UMO_TZ

    umo_phase_check
    umo_phase_deps
    umo_phase_config
    umo_phase_download
    umo_phase_proot
    umo_phase_perf
    umo_phase_vnc
    umo_phase_audio
    umo_phase_systemctl
    umo_phase_desktop
    umo_phase_apps
    umo_phase_theme
    umo_phase_finalize
    umo_phase_summary
}

umo_main "$@"
trap - EXIT INT TERM HUP
exit 0

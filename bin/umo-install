#!/bin/sh
# UMO - Main Installer (MIT License)
# https://github.com/shadow-x78/ubuntu-modded-optimized

set -e
unset LD_PRELOAD

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
export UMO_LIB_DIR="$SCRIPT_DIR/lib"
export UMO_MOD_DIR="$SCRIPT_DIR/modules"
export UMO_VERSION="4.3.0"

. "$UMO_LIB_DIR/core-ansi.sh"
. "$UMO_LIB_DIR/core-ui.sh"
. "$UMO_LIB_DIR/core-system.sh"
. "$UMO_LIB_DIR/core-net.sh"
. "$UMO_LIB_DIR/core-fs.sh"

. "$UMO_MOD_DIR/umo-proot.sh"
. "$UMO_MOD_DIR/umo-vnc.sh"
. "$UMO_MOD_DIR/umo-audio.sh"
. "$UMO_MOD_DIR/umo-systemctl.sh"
. "$UMO_MOD_DIR/umo-desktop.sh"
. "$UMO_MOD_DIR/umo-apps.sh"

UMO_INSTALL_DIR="${UMO_INSTALL_DIR:-$HOME/umo-ubuntu}"
UMO_UBUNTU_VERSION="${UMO_UBUNTU_VERSION:-22.04}"
UMO_DE="${UMO_DE:-xfce4}"
UMO_APP_SET="${UMO_APP_SET:-basic}"
UMO_PERF_MODE="${UMO_PERF_MODE:-balanced}"
UMO_THEME="${UMO_THEME:-umo-dark}"
UMO_LEAN="${UMO_LEAN:-0}"
UMO_NON_INTERACTIVE="${UMO_NON_INTERACTIVE:-}"

export UMO_INSTALL_DIR UMO_UBUNTU_VERSION UMO_DE UMO_APP_SET UMO_PERF_MODE UMO_THEME UMO_LEAN UMO_NON_INTERACTIVE

umo_phase_check() {
    umo_ui_init
    umo_ui_header "System Check"
    umo_sys_require_termux
    umo_sys_setup_storage
    umo_sys_require_arch
    umo_sys_require_internet
    umo_sys_require_space 2048
    umo_sys_summary
}

umo_phase_deps() {
    umo_ui_header "Dependencies"
    _install_deps() {
        _pkg_cmd="apt-get install -y"
        command -v pkg >/dev/null 2>&1 && _pkg_cmd="pkg install -y"
        $_pkg_cmd proot-distro wget tar pulseaudio x11-repo tur-repo git curl unzip >/dev/null 2>&1 || true
        $_pkg_cmd virglrenderer-android termux-x11-nightly >/dev/null 2>&1 || true
    }
    umo_run_quiet "Installing dependencies" _install_deps
}

umo_phase_config() {
    if [ -n "$UMO_NON_INTERACTIVE" ]; then
        umo_log_info "Non-interactive mode: DE=$UMO_DE, Apps=$UMO_APP_SET"
        return 0
    fi

    umo_ui_menu "Choose Ubuntu Version" \
        "Ubuntu 22.04 LTS (Jammy - Stable, Recommended)" \
        "Ubuntu 24.04 LTS (Noble - Latest)"

    case "$UMO_MENU_IDX" in
        1) UMO_UBUNTU_VERSION="22.04" ;;
        2) UMO_UBUNTU_VERSION="24.04" ;;
    esac

    umo_ui_menu "Choose Desktop Environment" \
        "XFCE4 (Recommended - Balanced)" \
        "LXDE (Ultra-Lightweight)" \
        "Openbox (Minimal - Advanced)" \
        "Minimal (CLI only - No GUI)"

    case "$UMO_MENU_IDX" in
        1) UMO_DE="xfce4" ;;
        2) UMO_DE="lxde" ;;
        3) UMO_DE="openbox" ;;
        4) UMO_DE="minimal" ;;
    esac

    umo_ui_menu "Choose Application Set" \
        "Basic (Utilities only)" \
        "Developer (Basic + Python/Node/GCC)" \
        "Media (Basic + VLC/FFmpeg)" \
        "Full Suite (Everything)"

    case "$UMO_MENU_IDX" in
        1) UMO_APP_SET="basic" ;;
        2) UMO_APP_SET="dev" ;;
        3) UMO_APP_SET="media" ;;
        4) UMO_APP_SET="full" ;;
    esac

    umo_ui_header "Configuration Summary"
    umo_kv "Desktop" "$UMO_DE"
    umo_kv "Apps"    "$UMO_APP_SET"
    umo_kv "Install" "$UMO_INSTALL_DIR"
    umo_kv "Version" "Ubuntu $UMO_UBUNTU_VERSION"

    umo_ui_confirm "Confirm installation?" "Y" || {
        umo_log_info "Installation cancelled."
        exit 0
    }
}

umo_phase_download() {
    umo_ui_header "Ubuntu RootFS"
    export UMO_CACHE_DIR="$HOME/.umo/cache"
    umo_fs_mkdir "$UMO_CACHE_DIR"

    _arch=$(uname -m)
    case "$_arch" in
        aarch64|arm64) _uarch="arm64" ;;
        armv7l|armv8l|arm) _uarch="armhf" ;;
        *) _uarch="arm64" ;;
    esac

    _archive="$UMO_CACHE_DIR/umo-rootfs-${_uarch}.tar.gz"
    umo_net_download_mirrors "$_archive"
    [ -f "$_archive" ] || umo_die "Download reported success but archive is missing: $_archive"
    umo_net_extract "$_archive" "$UMO_INSTALL_DIR"
    rm -f "$_archive"

    if [ ! -f "$UMO_INSTALL_DIR/bin/bash" ] || [ ! -f "$UMO_INSTALL_DIR/bin/sh" ]; then
        umo_die "RootFS extraction failed: /bin/bash or /bin/sh not found. Try a different mirror"
    fi
    umo_log_ok "RootFS integrity verified"
}

umo_phase_proot() {
    umo_ui_header "Proot Container"
    umo_run_quiet "Configuring Proot Container..." umo_proot_setup
    umo_run_quiet "Setting up Container User..." umo_proot_create_user
}

umo_phase_vnc() {
    [ "$UMO_DE" = "minimal" ] && { umo_log_info "Skipping VNC (minimal mode)."; return 0; }
    umo_ui_header "VNC Server"
    umo_vnc_setup
}

umo_phase_audio() {
    umo_ui_header "Audio Bridge"
    umo_run_quiet "Configuring Audio Bridge..." umo_audio_setup
}

umo_phase_systemctl() {
    umo_ui_header "Systemctl Emulator"
    umo_run_quiet "Configuring Systemctl Emulator..." umo_systemctl_setup
}

umo_phase_desktop() {
    [ "$UMO_DE" = "minimal" ] && { umo_log_info "Skipping desktop (minimal mode)."; return 0; }
    umo_ui_header "Desktop Environment"
    umo_de_install
}

umo_phase_apps() {
    umo_ui_header "Applications"
    umo_apps_install
}

umo_phase_finalize() {
    umo_ui_header "Finalizing"

    _umo_finalize_codename="jammy"
    [ "$UMO_UBUNTU_VERSION" = "24.04" ] && _umo_finalize_codename="noble"
    umo_run_quiet "Configuring APT sources..." sh -c "printf '%s\n' \
        'deb [trusted=yes] http://ports.ubuntu.com/ubuntu-ports ${_umo_finalize_codename} main restricted universe multiverse' \
        'deb [trusted=yes] http://ports.ubuntu.com/ubuntu-ports ${_umo_finalize_codename}-updates main restricted universe multiverse' \
        'deb [trusted=yes] http://ports.ubuntu.com/ubuntu-ports ${_umo_finalize_codename}-backports main restricted universe multiverse' \
        'deb [trusted=yes] http://ports.ubuntu.com/ubuntu-ports ${_umo_finalize_codename}-security main restricted universe multiverse' \
        > \"$UMO_INSTALL_DIR/etc/apt/sources.list\""
    umo_run_quiet "Installing dependencies..." "$HOME/umo-login.sh" -c "apt-get install -y sudo"
    umo_run_quiet "Configuring packages..." "$HOME/umo-login.sh" -c "dpkg --configure -a"
    umo_run_quiet "Setting up users..." "$HOME/umo-login.sh" -c "usermod -aG sudo umo"
    umo_run_quiet "Restoring service binaries..." "$HOME/umo-login.sh" -c "
        for _f in invoke-rc.d service systemctl; do
            if [ -L \"/usr/sbin/\$_f\" ] && [ -f \"/usr/sbin/\$_f.real\" ]; then
                rm -f \"/usr/sbin/\$_f\"
                mv \"/usr/sbin/\$_f.real\" \"/usr/sbin/\$_f\"
            fi
        done
    "

    _cplt_body='export DEBIAN_FRONTEND=noninteractive
_apt_filter() { grep -v "^Ign\|^Get:\|^Preparing\|^Unpacking\|^Selecting\|^Setting up\|^Processing\|^Reading\|^Building\|^Creating\|^debconf:" || true; }
timeout 300 dpkg --configure -a 2>&1 | _apt_filter || true
_broken=$(dpkg -l 2>/dev/null | awk "/^iU|^iF|^hF/{print \$2}")
if [ -n "$_broken" ]; then
    for _pkg in $_broken; do
        dpkg --remove --force-depends "$_pkg" 2>&1 | _apt_filter || true
    done
    timeout 300 apt-get -f install -y 2>&1 | _apt_filter || true
    timeout 300 dpkg --configure -a 2>&1 | _apt_filter || true
fi'
    umo_run_quiet "Configuring any remaining packages..." "$HOME/umo-login.sh" -c "$_cplt_body" || true
    umo_run_quiet "Cleaning dpkg locks..." "$HOME/umo-login.sh" -c "rm -f /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend 2>/dev/null || true" || true

    for _rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
        if [ -f "$_rc" ]; then
            sed -i -e '/alias umo=/d' -e '/alias startvnc=/d' -e '/alias stopvnc=/d' "$_rc" 2>/dev/null || true
        fi
    done

    for _proc in proot dbus-daemon pulseaudio Xvnc Xtigervnc termux-x11 dconf-service xfce4-session gpg-agent dirmngr; do
        pkill -9 -f "$_proc" 2>/dev/null || true
    done

    for _script in start stop; do
        _src="$SCRIPT_DIR/bin/umo-$_script"
        _dst="$HOME/umo-$_script.sh"
        if [ -f "$_src" ]; then
            cp -f "$_src" "$_dst"
            chmod +x "$_dst"
        fi
    done

    cat > "$HOME/../usr/bin/umo" << UMOCMD
#!/bin/sh
_UMO_VERSION="${UMO_VERSION}"
_UMO_REPO_DIR="${SCRIPT_DIR}"
UMOCMD
    cat >> "$HOME/../usr/bin/umo" << 'UMOCMD'
_UMO_NC='\033[0m'
_UMO_BOLD='\033[1m'
_UMO_DIM='\033[2m'
_UMO_PRI='\033[38;5;208m'
_UMO_CYN='\033[38;5;39m'
_UMO_GRN='\033[38;5;34m'
_UMO_RED='\033[38;5;196m'
_UMO_YEL='\033[38;5;220m'
_UMO_TERMUX_HOME="${HOME:-/data/data/com.termux/files/home}"

_umo_header() {
    printf "\n${_UMO_PRI}"
    printf "  ██╗   ██╗███╗   ███╗ ██████╗  \n"
    printf "  ██║   ██║████╗ ████║██╔═══██╗ \n"
    printf "  ██║   ██║██╔████╔██║██║   ██║ \n"
    printf "  ██║   ██║██║╚██╔╝██║██║   ██║ \n"
    printf "  ╚██████╔╝██║ ╚═╝ ██║╚██████╔╝ \n"
    printf "   ╚═════╝ ╚═╝     ╚═╝ ╚═════╝  \n"
    printf "${_UMO_NC}\n"
    printf "  ${_UMO_DIM}Ubuntu Modded Optimized · v${_UMO_VERSION}${_UMO_NC}\n"
    printf "  ${_UMO_PRI}────────────────────────────────────────${_UMO_NC}\n\n"
}

_umo_plate() {
    printf "\n  ${_UMO_PRI}────────────────────────────────────────${_UMO_NC}\n"
    printf "  ${_UMO_BOLD}UMO${_UMO_NC} ${_UMO_CYN}v${_UMO_VERSION}${_UMO_NC} ${_UMO_DIM}· $1${_UMO_NC}\n"
    printf "  ${_UMO_PRI}────────────────────────────────────────${_UMO_NC}\n\n"
}

_umo_ok()   { printf "  ${_UMO_GRN}[OK]${_UMO_NC}  %s\n" "$1"; }
_umo_err()  { printf "  ${_UMO_RED}[ERR]${_UMO_NC} %s\n" "$1" >&2; }
_umo_info() { printf "  ${_UMO_CYN}[..]${_UMO_NC}  %s\n" "$1"; }
_umo_warn() { printf "  ${_UMO_YEL}[!!]${_UMO_NC}  %s\n" "$1"; }
_umo_kv()   { printf "  ${_UMO_BOLD}%-14s${_UMO_NC} %b\n" "$1" "$2"; }

_umo_status() {
    _umo_plate "Service Status"
    _login="$_UMO_TERMUX_HOME/umo-login.sh"
    [ -f "$_login" ] && _installed="${_UMO_GRN}installed${_UMO_NC}" || _installed="${_UMO_RED}not installed${_UMO_NC}"
    _umo_kv "Container" "$_installed"

    _proot_pids=$(pgrep -f "proot.*umo" 2>/dev/null | tr '\n' ' ')
    if [ -n "$_proot_pids" ]; then
        _umo_kv "Session" "${_UMO_GRN}running${_UMO_NC} ${_UMO_DIM}(pid $_proot_pids)${_UMO_NC}"
    else
        _umo_kv "Session" "${_UMO_DIM}stopped${_UMO_NC}"
    fi

    _vnc_pid=$(pgrep -f "Xvnc" 2>/dev/null | head -1)
    [ -z "$_vnc_pid" ] && _vnc_pid=$(pgrep -f "Xtigervnc" 2>/dev/null | head -1)
    if [ -n "$_vnc_pid" ]; then
        _ip=$(ip route get 1 2>/dev/null | awk '{print $7; exit}')
        [ -z "$_ip" ] && _ip="127.0.0.1"
        _umo_kv "VNC" "${_UMO_GRN}active${_UMO_NC} ${_UMO_CYN}${_ip}:5901${_UMO_NC}"
    else
        _umo_kv "VNC" "${_UMO_DIM}stopped${_UMO_NC}"
    fi

    _pulse=$(pgrep -f "pulseaudio" 2>/dev/null | head -1)
    if [ -n "$_pulse" ]; then
        _umo_kv "Audio" "${_UMO_GRN}running${_UMO_NC}"
    else
        _umo_kv "Audio" "${_UMO_DIM}stopped${_UMO_NC}"
    fi

    if [ -d "$_UMO_REPO_DIR/.git" ] && [ "${UMO_CHECK_UPDATES:-0}" = "1" ]; then
        _fh="$_UMO_REPO_DIR/.git/FETCH_HEAD"
        _stale=1
        if [ -f "$_fh" ]; then
            _fh_age=$(( $(date +%s) - $(stat -c %Y "$_fh" 2>/dev/null || echo 0) ))
            [ "$_fh_age" -lt 600 ] && _stale=0
        fi
        [ "$_stale" = 1 ] && git -C "$_UMO_REPO_DIR" fetch origin main >/dev/null 2>&1 || true
        _behind=$(git -C "$_UMO_REPO_DIR" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
        if [ "$_behind" -gt 0 ] 2>/dev/null; then
            _umo_kv "Updates" "${_UMO_YEL}$_behind new commits on main${_UMO_NC} (umo update)"
        else
            _umo_kv "Updates" "${_UMO_DIM}up to date${_UMO_NC}"
        fi
    fi
    printf "\n"
}

_umo_refresh_host() {
    _umo_info "Refreshing host-side scripts..."
    _tpl="$_UMO_REPO_DIR/config/templates"
    _inst_dir=$(grep '^INSTALL_DIR=' "$_UMO_TERMUX_HOME/umo-login.sh" 2>/dev/null | head -1 | cut -d'"' -f2)
    [ -z "$_inst_dir" ] && _inst_dir="$HOME/umo-ubuntu"

    _umo_user="umo"
    if [ -f "$_UMO_TERMUX_HOME/umo-user.sh" ]; then
        _cur_user=$(sed -n 's/.*\/bin\/su - \([^ ]*\).*/\1/p' "$_UMO_TERMUX_HOME/umo-user.sh" | head -1)
        [ -n "$_cur_user" ] && _umo_user="$_cur_user"
    fi

    if [ -f "$_tpl/umo-login.sh" ]; then
        sed -e "s|{{INSTALL_DIR}}|$_inst_dir|g" \
            -e "s|{{TERMUX_PREFIX}}|$PREFIX|g" \
            "$_tpl/umo-login.sh" > "$_UMO_TERMUX_HOME/umo-login.sh"
        chmod +x "$_UMO_TERMUX_HOME/umo-login.sh"
    fi
    for _pair in umo-user.sh:umo-user.sh umo-startvnc.sh:umo-vnc-start.sh umo-stopvnc.sh:umo-vnc-stop.sh; do
        _src="$_tpl/${_pair%%:*}"
        _dst="$_UMO_TERMUX_HOME/${_pair##*:}"
        if [ -f "$_src" ]; then
            sed -e "s|{{INSTALL_DIR}}|$_inst_dir|g" \
                -e "s|{{TERMUX_PREFIX}}|$PREFIX|g" \
                -e "s|{{UMO_USER}}|$_umo_user|g" \
                -e "s|{{DISPLAY}}|:1|g" \
                -e "s|{{VNC_DEPTH}}|24|g" \
                -e "s|{{VNC_PORT}}|5901|g" \
                "$_src" > "$_dst"
            chmod +x "$_dst"
        fi
    done
    for _script in start stop; do
        [ -f "$_UMO_REPO_DIR/bin/umo-$_script" ] || continue
        cp -f "$_UMO_REPO_DIR/bin/umo-$_script" "$_UMO_TERMUX_HOME/umo-$_script.sh"
        chmod +x "$_UMO_TERMUX_HOME/umo-$_script.sh"
    done
    _umo_ok "Host scripts updated (user: $_umo_user)"
}

_umo_refresh_container() {
    [ -f "$_UMO_TERMUX_HOME/umo-login.sh" ] || return 0
    if ! pgrep -f "proot.*umo" >/dev/null 2>&1; then
        _umo_warn "Container is not running, skipping in-container hooks"
        return 0
    fi
    _umo_info "Applying in-container update hooks..."
    "$_UMO_TERMUX_HOME/umo-login.sh" -c "
        [ -f /etc/apt/apt.conf.d/99-umo-speed ] && true
        rm -f /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend 2>/dev/null || true
    " </dev/null >/dev/null 2>&1 || true
    _umo_ok "Container hooks applied"
}

_umo_run_update() {
    _umo_plate "Update"
    if [ ! -d "$_UMO_REPO_DIR/.git" ]; then
        _umo_err "UMO was not installed via git clone, cannot auto-update"
        exit 1
    fi

    _umo_info "Fetching latest changes from origin/main..."
    if ! git -C "$_UMO_REPO_DIR" fetch origin main 2>/dev/null; then
        _umo_err "Could not reach GitHub. Check your connection and retry."
        exit 1
    fi

    _behind=$(git -C "$_UMO_REPO_DIR" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
    if [ "$_behind" -eq 0 ] 2>/dev/null; then
        _umo_ok "UMO is already up to date (v$_UMO_VERSION)"
        exit 0
    fi

    printf "  ${_UMO_DIM}%s new commits on main:${_UMO_NC}\n" "$_behind"
    git -C "$_UMO_REPO_DIR" log --oneline --no-decorate HEAD..origin/main 2>/dev/null | head -10 | while IFS= read -r _line; do
        printf "  ${_UMO_CYN}  ➜${_UMO_NC} %s\n" "$_line"
    done
    printf "\n"

    _stashed=0
    if [ -n "$(git -C "$_UMO_REPO_DIR" status --porcelain 2>/dev/null)" ]; then
        _umo_warn "Local modifications detected, stashing them first"
        git -C "$_UMO_REPO_DIR" stash push -m "umo auto-stash $(date +%Y%m%d-%H%M%S)" >/dev/null 2>&1 && _stashed=1
    fi

    if ! git -C "$_UMO_REPO_DIR" reset --hard origin/main >/dev/null 2>&1; then
        _umo_err "Failed to apply updates"
        [ "$_stashed" = 1 ] && git -C "$_UMO_REPO_DIR" stash pop >/dev/null 2>&1 || true
        exit 1
    fi

    if [ "$_stashed" = 1 ]; then
        if git -C "$_UMO_REPO_DIR" stash pop >/dev/null 2>&1; then
            _umo_ok "Your local changes were preserved"
        else
            _umo_warn "Stash kept (conflict), resolve with: git -C $_UMO_REPO_DIR stash pop"
        fi
    fi

    _new_ver=$(sed -n 's/^export UMO_VERSION="\([^"]*\)"/\1/p' "$_UMO_REPO_DIR/bin/umo-install" 2>/dev/null)
    [ -n "$_new_ver" ] && _UMO_VERSION="$_new_ver"

    _umo_refresh_host
    _umo_refresh_container

    printf "\n"
    _umo_ok "UMO updated to v$_UMO_VERSION"
    printf "  ${_UMO_DIM}Run ${_UMO_CYN}umo status${_UMO_DIM} to verify the environment.${_UMO_NC}\n\n"
}

_umo_run_cmd() {
    if [ -z "$1" ]; then
        _umo_err "No command provided. Usage: umo run \"<command>\""
        exit 1
    fi
    "$_UMO_TERMUX_HOME/umo-login.sh" -c "$*"
}

_umo_set_user() {
    _umo_plate "User"
    _new_user="$1"
    if [ -z "$_new_user" ]; then
        _umo_err "Usage: umo --user <username>"
        exit 1
    fi
    _login="$_UMO_TERMUX_HOME/umo-login.sh"
    _user_sh="$_UMO_TERMUX_HOME/umo-user.sh"
    if [ ! -f "$_login" ]; then
        _umo_err "UMO not installed"
        exit 1
    fi
    _umo_info "Switching default user to: $_new_user"
    "$_UMO_TERMUX_HOME/umo-login.sh" -c "id $_new_user >/dev/null 2>&1 || { useradd -m -s /bin/bash $_new_user && echo '${_new_user}:${_new_user}' | chpasswd; }" </dev/null >/dev/null 2>&1
    sed -i "s|/bin/su - [^ ]*|/bin/su - $_new_user|g" "$_user_sh" 2>/dev/null || true
    sed -i "s|HOME=/home/[^ ]*|HOME=/home/$_new_user|g" "$_user_sh" 2>/dev/null || true
    _umo_ok "Default user is now: $_new_user"
    printf "  ${_UMO_DIM}Run ${_UMO_CYN}umo user${_UMO_DIM} to login as ${_new_user}.${_UMO_NC}\n\n"
}

_umo_backup() {
    _umo_plate "Backup"
    _bak_dir="${1:-$_UMO_TERMUX_HOME/umo-backup}"
    _bak_file="$_bak_dir/umo-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    _install_dir=$(grep '^INSTALL_DIR=' "$_UMO_TERMUX_HOME/umo-login.sh" 2>/dev/null | head -1 | cut -d'"' -f2)
    if [ -z "$_install_dir" ] || [ ! -d "$_install_dir" ]; then
        _umo_err "Cannot find UMO install directory"
        exit 1
    fi
    mkdir -p "$_bak_dir"
    _umo_info "Backing up to: $_bak_file"
    tar -czf "$_bak_file" -C "$(dirname "$_install_dir")" "$(basename "$_install_dir")" 2>/dev/null
    _sz=$(du -sh "$_bak_file" 2>/dev/null | cut -f1)
    _umo_ok "Backup complete (size: $_sz)"
    printf "  ${_UMO_DIM}%s${_UMO_NC}\n\n" "$_bak_file"
}

_umo_help() {
    _umo_plate "Command Reference"

    printf "  ${_UMO_BOLD}USAGE${_UMO_NC}\n"
    printf "    ${_UMO_CYN}umo${_UMO_NC} <command> [options]\n\n"

    printf "  ${_UMO_PRI}Session Lifecycle${_UMO_NC} ${_UMO_DIM}(control the running environment)${_UMO_NC}\n"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "start"              "Boot Ubuntu with VNC and audio servers"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "stop"               "Terminate all running UMO services"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "status"             "Live service status and update check"
    printf "\n"

    printf "  ${_UMO_PRI}Terminal Access${_UMO_NC} ${_UMO_DIM}(work inside the container)${_UMO_NC}\n"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "login"              "Root shell inside Ubuntu"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "user"               "Shell as the default user"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "run <cmd>"          "Execute one command inside Ubuntu"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "--user <name>"      "Switch the default login user"
    printf "\n"

    printf "  ${_UMO_PRI}Maintenance${_UMO_NC} ${_UMO_DIM}(keep UMO current and safe)${_UMO_NC}\n"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "vnc"                "Start the VNC server manually"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "update"             "Fetch and apply the latest UMO version"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "backup [dir]"       "Archive the rootfs to <dir>"
    printf "\n"

    printf "  ${_UMO_PRI}General${_UMO_NC}\n"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "version"            "Print version banner"
    printf "    ${_UMO_CYN}%-22s${_UMO_NC} %s\n" "help"               "This reference"
    printf "\n"

    printf "  ${_UMO_PRI}Common Tasks${_UMO_NC}\n"
    printf "    ${_UMO_DIM}$\033[0m ${_UMO_CYN}umo login${_UMO_NC}                  shell into the container\n"
    printf "    ${_UMO_DIM}$\033[0m ${_UMO_CYN}umo start${_UMO_NC}                  launch desktop, connect at :5901\n"
    printf "    ${_UMO_DIM}$\033[0m ${_UMO_CYN}umo backup && umo update${_UMO_NC} backup first, then upgrade\n"
    printf "    ${_UMO_DIM}$\033[0m ${_UMO_CYN}umo run \"apt list --upgradable\"${_UMO_NC}  inspect container packages\n"
    printf "\n"
}

case "$1" in
    start)                  exec "$_UMO_TERMUX_HOME/umo-start.sh" "$2" ;;
    stop)                   exec "$_UMO_TERMUX_HOME/umo-stop.sh" ;;
    login)                  exec "$_UMO_TERMUX_HOME/umo-login.sh" ;;
    user)                   exec "$_UMO_TERMUX_HOME/umo-user.sh" ;;
    vnc)                    exec "$_UMO_TERMUX_HOME/umo-vnc-start.sh" ;;
    status)                 _umo_status ;;
    update)                 _umo_run_update ;;
    run)                    shift; _umo_run_cmd "$@" ;;
    backup)                 shift; _umo_backup "$@" ;;
    --user|-u)              shift; _umo_set_user "$1" ;;
    --version|-v|version)   _umo_header ;;
    help|--help|-h)         _umo_help ;;
    "")
        _umo_err "No command provided"
        printf "  Run '${_UMO_CYN}umo --help${_UMO_NC}' for usage.\n\n"
        exit 1
        ;;
    *)
        _umo_err "Unknown command: $1"
        printf "  Run '${_UMO_CYN}umo --help${_UMO_NC}' for usage.\n\n"
        exit 1
        ;;
esac
UMOCMD
    chmod +x "$HOME/../usr/bin/umo"

    umo_log_ok "Finalized"
}

umo_phase_summary() {
    _ip=$(ip route get 1 2>/dev/null | awk '{print $7; exit}')
    [ -z "$_ip" ] && _ip="127.0.0.1"

    umo_screen_clear
    umo_banner
    umo_rule

    printf "\n  %b%bInstallation Complete%b\n" "$UMO_BOLD" "$UMO_COLOR_SUCCESS" "$UMO_NC"
    printf "  %b" "$UMO_COLOR_PRIMARY"
    umo_repeat "$UMO_LINE_H" 21
    printf "%b\n\n" "$UMO_NC"

    umo_kv "Version" "Ubuntu $UMO_UBUNTU_VERSION"
    umo_kv "Desktop" "$UMO_DE"
    umo_kv "Path"    "$UMO_INSTALL_DIR"

    termux-wake-unlock >/dev/null 2>&1 || true
    umo_kv "VNC"     "$_ip:5901"
    umo_kv "User"    "umo (login: umo, VNC: ubuntu)"

    printf "\n  %b%bGet Started%b\n" "$UMO_BOLD" "$UMO_COLOR_PRIMARY" "$UMO_NC"
    printf "  %b" "$UMO_COLOR_PRIMARY"
    umo_repeat "$UMO_LINE_H" 11
    printf "%b\n\n" "$UMO_NC"

    printf "  %b%-28s%b %s\n" "$UMO_B_CYAN" "umo start" "$UMO_NC" "Start UMO session & VNC"
    printf "  %b%-28s%b %s\n" "$UMO_B_CYAN" "umo stop" "$UMO_NC" "Stop all services"
    printf "  %b%-28s%b %s\n" "$UMO_B_CYAN" "umo login" "$UMO_NC" "Login as root"
    printf "  %b%-28s%b %s\n" "$UMO_B_CYAN" "umo user" "$UMO_NC" "Login as default user"
    printf "  %b%-28s%b %s\n" "$UMO_B_CYAN" "umo --user <name>" "$UMO_NC" "Switch default user"
    printf "  %b%-28s%b %s\n" "$UMO_B_CYAN" "umo status" "$UMO_NC" "Show service status"
    printf "  %b%-28s%b %s\n" "$UMO_B_CYAN" "umo backup" "$UMO_NC" "Backup system rootfs"
    printf "  %b%-28s%b %s\n" "$UMO_B_CYAN" "umo update" "$UMO_NC" "Update UMO script"
    printf "  %b%-28s%b %s\n" "$UMO_B_CYAN" "umo --help" "$UMO_NC" "Full command reference"

_readme_dir="$UMO_INSTALL_DIR/root/.umo"
    umo_fs_mkdir "$_readme_dir" 2>/dev/null || true
    timeout 5 sh -c "cat > '$_readme_dir/README.txt' 2>/dev/null" << README_EOF || true
========================================
  UMO Ubuntu - v$UMO_VERSION
  Version: $UMO_UBUNTU_VERSION
  Desktop: $UMO_DE
========================================

Commands (run from Termux):
  umo stop             Stop all services
  umo login            Login as root
  umo user              Login as default user
  umo --user <name>    Switch user
  umo status           Show service status
  umo update           Update packages
  umo --help           Full help

VNC: $_ip:5901
User: umo (Login pass: umo, VNC pass: ubuntu)

========================================
README_EOF

    printf "\n  %bRun %bumo --help%b%b for the full command reference.%b\n\n" "$UMO_DIM" "$UMO_B_CYAN" "$UMO_NC" "$UMO_DIM" "$UMO_NC"
}

umo_cli_parse() {
    for _arg in "$@"; do
        case "$_arg" in
            --no-gui|--non-interactive) UMO_NON_INTERACTIVE=1 ;;
            --de=*)      UMO_DE="${_arg#*=}" ;;
            --apps=*)    UMO_APP_SET="${_arg#*=}" ;;
            --dir=*)     UMO_INSTALL_DIR="${_arg#*=}" ;;
            --ubuntu=*)  UMO_UBUNTU_VERSION="${_arg#*=}" ;;
            --version=*) UMO_UBUNTU_VERSION="${_arg#*=}" ;;
            --perf=*)    UMO_PERF_MODE="${_arg#*=}" ;;
            --theme=*)   UMO_THEME="${_arg#*=}" ;;
            --lean)      UMO_LEAN=1 ;;
            --help|-h)
                printf "\n  %bUbuntu Modded Optimized (UMO) Installer%b\n\n" "$UMO_BOLD" "$UMO_NC"
                printf "  %bUSAGE:%b\n" "$UMO_BOLD" "$UMO_NC"
                printf "    %bumo-install%b [OPTIONS]\n\n" "$UMO_B_CYAN" "$UMO_NC"
                
                printf "  %bOPTIONS:%b\n" "$UMO_BOLD" "$UMO_NC"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "-h, --help" "$UMO_NC" "Print help information"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--no-gui, --non-interactive" "$UMO_NC" "Run in non-interactive mode"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--lean" "$UMO_NC" "Remove docs/man/locales to save space"
                printf "\n"
                
                printf "  %bCONFIGURATION:%b\n" "$UMO_BOLD" "$UMO_NC"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--de=<env>" "$UMO_NC" "Desktop environment (xfce4, lxde, openbox)"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--apps=<set>" "$UMO_NC" "Application set (basic, dev, media, full)"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--dir=<path>" "$UMO_NC" "Installation directory"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--ubuntu=<version>" "$UMO_NC" "Ubuntu version (22.04, 24.04)"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--perf=<mode>" "$UMO_NC" "Performance level (balanced, aggressive, off) [default: balanced]"
                printf "    %b%-30s%b %s\n" "$UMO_B_CYAN" "--theme=<theme>" "$UMO_NC" "Desktop theme (umo-dark, umo-light, minimal, none)"
                printf "\n"
                
                printf "  %bEXAMPLES:%b\n" "$UMO_BOLD" "$UMO_NC"
                printf "    %b\$ umo-install --no-gui --de=xfce4 --apps=full%b\n" "$UMO_DIM" "$UMO_NC"
                printf "    %b\$ umo-install --dir=/data/data/com.termux/files/home/ubuntu%b\n\n" "$UMO_DIM" "$UMO_NC"
                exit 0
                ;;
        esac
    done
}

. "$UMO_MOD_DIR/umo-perf.sh" 2>/dev/null || true

umo_phase_perf() {
    [ "$UMO_PERF_MODE" = "off" ] && { umo_log_info "Performance tuning disabled."; return 0; }
    umo_ui_header "Performance Tuning"
    if command -v umo_perf_setup >/dev/null 2>&1; then
        umo_perf_setup
        umo_log_ok "Performance optimizations applied (mode: $UMO_PERF_MODE)"
    else
        umo_log_warn "Performance module not available, skipping"
    fi
}

. "$UMO_MOD_DIR/umo-theme.sh" 2>/dev/null || true

umo_phase_theme() {
    [ "$UMO_THEME" = "none" ] && { umo_log_info "Theme disabled."; return 0; }
    umo_ui_header "Desktop Theme"
    export SCRIPT_DIR
    if command -v umo_theme_setup >/dev/null 2>&1; then
        umo_theme_setup
        umo_log_ok "Desktop theme applied ($UMO_THEME)"
    else
        umo_log_warn "Theme module not available, skipping"
    fi
}

umo_main() {
    umo_cli_parse "$@"

    _umo_exit_code=0
    _umo_sigint_cleanup() {
        _umo_exit_code=${_umo_exit_code:-130}
        trap - EXIT INT TERM HUP
        for _sig in INT TERM HUP; do trap "" "$_sig"; done
        _inst_dir="${UMO_INSTALL_DIR:-$HOME/umo-ubuntu}"
        _inst_re=$(printf '%s' "$_inst_dir" | sed 's/[][\\.*^$()+?{|/]/\\&/g')
        _login_re=$(printf '%s' "$HOME/umo-login.sh" | sed 's/[][\\.*^$()+?{|/]/\\&/g')
        timeout 5 sh -c "
            pkill -KILL -f 'proot.*${_inst_re}'      2>/dev/null || true
            pkill -KILL -f '${_login_re}'              2>/dev/null || true
            pkill -KILL -f 'install-vnc.sh'             2>/dev/null || true
            pkill -KILL -f 'install-de.sh'              2>/dev/null || true
            pkill -KILL -f 'install-theme.sh'           2>/dev/null || true
            pkill -KILL -f 'debloat.sh'                 2>/dev/null || true
            pkill -KILL -f 'cleanup.sh'                 2>/dev/null || true
            pkill -KILL -f 'perf-desktop.sh'            2>/dev/null || true
            pkill -KILL -f 'divert-triggers.sh'         2>/dev/null || true
            pkill -KILL -f 'apt-get'                     2>/dev/null || true
            pkill -KILL -f 'dpkg'                        2>/dev/null || true
            umo_cursor_show 2>/dev/null
        " 2>/dev/null
        exit "$_umo_exit_code"
    }
    trap _umo_sigint_cleanup EXIT INT TERM HUP

    case "$UMO_THEME" in
        umo-dark|umo-light|none|'') ;;
        *) UMO_THEME="umo-dark" ;;
    esac

    umo_phase_check
    umo_phase_deps
    umo_phase_config
    umo_phase_download
    umo_phase_proot
    umo_phase_perf
    umo_phase_vnc
    umo_phase_audio
    umo_phase_systemctl
    umo_phase_desktop
    umo_phase_apps
    umo_phase_theme
    umo_phase_finalize
    umo_phase_summary
}

umo_main "$@"
trap - EXIT INT TERM HUP
exit 0
